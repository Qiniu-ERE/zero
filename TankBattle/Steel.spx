var (
	alive bool // 只有克隆体才是 true
)

// 在 (x, y) 放一块钢墙（克隆）
func build(x, y float64) {
	setXYpos x, y
	clone
}

onCloned => {
	alive = true
	setCostume look("steel")
	show
}

onMsg "themeChanged", => {
	if alive {
		setCostume look("steel")
	}
}

onMsg "clear", => {
	if alive {
		alive = false
		destroy
	}
}
