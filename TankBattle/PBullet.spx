var (
	face  int  // 朝向；2P 的子弹加了 1000（见 bulletDir），这样不用多加字段也能分清是谁打的
	alive bool // 只有克隆体才是 true
)

// 从坦克 (x, y) 处朝 d 方向发射一发子弹，who 是 1（1P）或 2（2P）
func fire(x, y float64, d int, who int) {
	face = d
	if who == 2 {
		face = d + 1000
		pbCount2++
	} else {
		pbCount++
	}
	setXYpos x+dirDX(d)*14, y+dirDY(d)*14
	clone
}

// 子弹消失（带一个小爆炸）
func vanish() {
	alive = false
	if face >= 500 {
		pbCount2--
	} else {
		pbCount--
	}
	Boom.explodeAt xpos, ypos, 0.4
	destroy
}

onCloned => {
	alive = true
	setCostume look("bullet")
	show
	for alive {
		waitNextFrame
		if gameOver {
			continue
		}
		dt := deltaTime
		if dt > 0.05 {
			dt = 0.05
		}
		d := bulletDir(face)
		x0, y0 := xpos, ypos
		changeXYpos dirDX(d)*260*dt, dirDY(d)*260*dt
		// 和敌人子弹迎面相撞，双双抵消：看这一帧飞过的路线上有没有敌人子弹
		// （半径 = 子弹直径 6 像素 + 敌人子弹这一帧飞的距离，见 main.spx 的 bulletClash）
		if bulletClash(x0, y0, xpos, ypos, 6+180*dt) {
			vanish
		}
		if bulletHit(xpos, ypos, d, true) {
			vanish
		}
	}
}

// 打中了敌人坦克（由敌人发出这条消息）
onMsg "pbHit", => {
	if alive {
		vanish
	}
}

onMsg "clear", => {
	if alive {
		alive = false
		destroy
	}
}
