var (
	face  int
	alive bool // 只有克隆体才是 true
)

// 从敌人坦克 (x, y) 处朝 d 方向发射一发子弹
func fire(x, y float64, d int) {
	face = d
	setXYpos x+dirDX(d)*14, y+dirDY(d)*14
	clone
}

func vanish() {
	alive = false
	delete ebPos, this
	delete ebHit, this
	Boom.explodeAt xpos, ypos, 0.4
	destroy
}

onCloned => {
	alive = true
	setCostume look("bullet")
	show
	for alive {
		waitNextFrame
		if gameOver {
			continue
		}
		dt := deltaTime
		if dt > 0.05 {
			dt = 0.05
		}
		if ebHit[this] { // 被玩家子弹迎面撞上了（PBullet 判断的）
			vanish
			break
		}
		changeXYpos dirDX(face)*180*dt, dirDY(face)*180*dt
		if ebPos == nil {
			ebPos = map[*EBullet][2]float64{}
		}
		ebPos[this] = [2]float64{xpos, ypos}
		if touching("Player") {
			// 双人时看离哪辆坦克更近（死掉的坦克报的位置很远）
			hitWho = nearestPlayer(xpos, ypos)
			broadcast "playerHit"
			vanish
		}
		if bulletHit(xpos, ypos, face, false) {
			vanish
		}
	}
}

// 复活时清场：敌人子弹全部消失
onMsg "reviveClear", => {
	if alive {
		alive = false
		delete ebPos, this
		delete ebHit, this
		destroy
	}
}

onMsg "clear", => {
	if alive {
		alive = false
		delete ebPos, this
		delete ebHit, this
		destroy
	}
}
