var (
	idx   int  // 这块砖在地图中的格子编号
	alive bool // 只有克隆体才是 true
)

// 在 (x, y) 放一块砖（克隆），i 是格子编号
func build(x, y float64, i int) {
	idx = i
	setXYpos x, y
	clone
}

onCloned => {
	alive = true
	setCostume look("brick")
	show
}

onMsg (msg, data) => {
	if !alive {
		return
	}
	if msg == "brickCracked" && data == idx {
		setCostume look("cracked")
	}
	if msg == "themeChanged" {
		if grid[idx] == 3 {
			setCostume look("cracked")
		} else {
			setCostume look("brick")
		}
	}
	if msg == "clear" || (msg == "brickBroken" && data == idx) {
		alive = false
		destroy
	}
}
