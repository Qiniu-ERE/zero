var (
	kind   int     // 0 普通，1 快速，2 重型；精英再加 10（v6，不加字段：方法表上限）
	hp     int     // 还能挨几发子弹
	spd    float64 // 移动速度（像素/秒）
	face   int     // 朝向：0 上，90 右，180 下，-90 左
	fireCD float64 // 距离下次开火的时间
	turnCD float64 // 距离下次随机转向的时间
	alive  bool    // 只有克隆体才是 true
)

// 在 (x, y) 放出一辆 k 类型的敌人（克隆）
func spawn(x, y float64, k int) {
	kind = k
	setXYpos x, y
	clone
}

// 转向，并对齐到半格
func setFace(d int) {
	face = d
	setHeading float64(d)
	nx := snapX(xpos)
	ny := snapY(ypos)
	if !tankBlocked(nx, ny) {
		setXYpos nx, ny
	}
}

// 类型（0 普通，1 快速，2 重型），不管是不是精英
func baseKind() int {
	return kind % 10
}

func isElite() bool {
	return kind >= 10
}

// 一共能挨几发：普通、快速 1 发，重型 3 发，精英多 1 发
func maxHp() int {
	n := 1
	if baseKind() == 2 {
		n = 3
	}
	if isElite() {
		n++
	}
	return n
}

// 按类型和当前画风换造型（精英的造型名带 _e）
func applyLook() {
	name := "basic"
	if baseKind() == 1 {
		name = "fast"
	} else if baseKind() == 2 {
		name = "heavy"
	}
	if isElite() {
		name += "_e"
	}
	setCostume look(name)
}

// 随机选一个方向，更喜欢往下（基地方向）走
func pickFace() {
	n := int(rand(1, 10))
	if n <= 4 {
		setFace 180
	} else if n <= 6 {
		setFace -90
	} else if n <= 8 {
		setFace 90
	} else {
		setFace 0
	}
}

func touchingTank() bool {
	return touching("Enemy") || touching("Player")
}

// 往前开，撞到东西就退回来并换个方向
func drive(dt float64) {
	wasTouching := touchingTank()
	dx := dirDX(face) * spd * dt
	dy := dirDY(face) * spd * dt
	changeXYpos dx, dy
	if tankBlocked(xpos, ypos) || (!wasTouching && touchingTank()) {
		changeXYpos -dx, -dy
		pickFace
	}
}

// 被玩家子弹打中
func takeHit() {
	pbHitX = xpos // 只让打中自己的那一发消失（双人时另一个人的子弹不受影响）
	pbHitY = ypos
	broadcastAndWait "pbHit"
	hp--
	if hp > 0 {
		sfx "armor"
		setGraphicEffect ColorEffect, float64((maxHp()-hp)*40)
		return
	}
	die
}

// 被击毁（挨够了子弹，或者空袭）：加分；精英掉一块芯片（v6）
func die() {
	alive = false
	points := 100
	if baseKind() == 1 {
		points = 200
	} else if baseKind() == 2 {
		points = 400
	}
	if isElite() {
		points += elitePoints
	}
	sfx "explode"
	enemyKilled points
	if isElite() {
		eliteDown xpos, ypos
	}
	Boom.explodeAt xpos, ypos, 1.2
	destroy
}

onCloned => {
	alive = true
	hp = maxHp()
	if baseKind() == 1 {
		spd = 75
	} else if baseKind() == 2 {
		spd = 30
	} else {
		spd = 40
	}
	if isElite() {
		spd *= 1.15
	}
	applyLook
	setFace 180
	fireCD = rand(0.5, 1.5)
	turnCD = rand(1.2, 3.2)
	show
	for alive {
		waitNextFrame
		if gameOver {
			continue
		}
		dt := deltaTime
		if dt > 0.05 {
			dt = 0.05
		}
		if autopilot {
			seeEnemy xpos, ypos // 路演演示：告诉自动驾驶自己在哪
		}
		if freezeLeft <= 0 { // 冰冻（v6 战术芯片）：原地不动、不开火，但照样能被打中
			drive dt
			turnCD -= dt
			if turnCD <= 0 {
				pickFace
				turnCD = rand(1.2, 3.2)
			}
			fireCD -= dt
			if fireCD <= 0 {
				EBullet.fire xpos, ypos, face
				fireCD = rand(1.0, 2.5)
			}
		}
		if touching("PBullet") {
			takeHit
		}
	}
}

onMsg "themeChanged", => {
	if alive {
		applyLook
	}
}

// 复活时清场：基地附近（3 格以内）的敌人消失。不算击毁，让它以后重新出场（总数还是 20 辆）
onMsg "reviveClear", => {
	if alive && xpos-baseX < 84 && baseX-xpos < 84 && ypos-baseY < 84 {
		alive = false
		enemiesAlive--
		spawned--
		Boom.explodeAt xpos, ypos, 0.8
		destroy
	}
}

// 空袭（v6 战术芯片）：场上的敌人全部被击毁（照样加分，精英照样掉芯片）
onMsg "bomb", => {
	if alive {
		die
	}
}

// 钢铁堡垒放墙前：报告自己压着哪些格子
onMsg "markTanks", => {
	if alive {
		markTank xpos, ypos
	}
}

onMsg "clear", => {
	if alive {
		alive = false
		destroy
	}
}
