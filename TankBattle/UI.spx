import (
	"strconv"
	"strings"
)

// 所有界面元素（标签、数字、图标、语言按钮、提示条、广告位、弹窗画面）都是 UI 的克隆，用 kind 区分。
//
// 为什么这样写：spx 解释器（本地 spx run 和 XBuilder 网页版共用）的方法表有全局上限 2560。
// 实测发现，每出现一种“新的字段总大小”的精灵类型，就要多占约 110 个位置，v1 已经接近上限。
// 所以 UI 的字段总大小固定为 56 字节（和 Enemy 相同）：不要随意增删字段，新功能请复用下面这几个。
// 详见 docs/ARCHITECTURE.md 的「解释器方法表上限」。
var (
	kind  int     // 见下面的 kind 常量
	key   string  // 标签 / 提示条：文案 key，造型名是 "<key>_<语言>"；广告位："card" 或 "banner"
	slot  int     // 数字：第几个字符；图标：第几个
	baseX float64 // 数字：锚点
	baseY float64
	left  float64 // 提示条：还要显示多久（秒）
)

const (
	kLabel = 1 // 文字标签
	kScore = 2 // 得分的一个字符位（大号白色，左对齐）
	kBest  = 3 // 最高分的一个字符位（小号金色，右对齐）
	kPip   = 4 // 顶栏的敌军剩余格子
	kLife  = 5 // 生命图标
	kLang  = 6 // 中 | EN 语言按钮
	kToast  = 7  // 提示条
	kAd     = 8  // 广告位：对局中的原生广告卡（key "card"）或主页横幅（key "banner"）
	kScreen = 9  // 全屏 / 弹窗画面：主页、复活、模拟广告、结算（造型名在舞台的 screen 里）
	kCoin   = 10 // 结算弹窗里金币数的一个字符位（金色，左对齐）
	kLife2  = 11 // 2P 的生命图标（只在双人时显示）

	// 地图编辑器的小部件（只在编辑器里显示）
	kEdSel    = 12 // 当前工具的选中框
	kEdSwitch = 13 // slot 0：对称开关；slot 1：战场中间的对称线
	kEdStatus = 14 // 检查结果
	kEdCursor = 15 // 鼠标所在的格子
	kEdMark   = 16 // 出问题的格子

	kTouchPad = 17 // 触屏模式的方向键（手机 App 里替换右侧的按键说明）
)

// ---------- 创建 ----------

// 文字标签，(x, y) 是文字锚点（造型里已经按左 / 中 / 右对齐设好）
func label(x, y float64, k string) {
	kind = kLabel
	key = k
	setXYpos x, y
	clone
}

// 数字，k 是 kScore 或 kBest，最多 n 个字符，每个字符位一个克隆
func number(k int, x, y float64, n int) {
	kind = k
	baseX = x
	baseY = y
	for i := 0; i < n; i++ {
		slot = i
		clone
	}
}

// 图标，k 是 kPip 或 kLife
func icon(k int, x, y float64, i int) {
	kind = k
	slot = i
	setXYpos x, y
	clone
}

func langButton(x, y float64) {
	kind = kLang
	setXYpos x, y
	clone
}

func toastBar(x, y float64) {
	kind = kToast
	setXYpos x, y
	clone
}

// 广告位，k 是 "card" 或 "banner"
func adSlot(x, y float64, k string) {
	kind = kAd
	key = k
	setXYpos x, y
	clone
}

func screenLayer() {
	kind = kScreen
	setXYpos 0, 0
	clone
}

// ---------- 点击区域 ----------

// (x, y) 是否在按钮 name 的范围内（由 tools/assets/build.py 生成，和画面保持一致）
func hit(name string, x, y float64) bool {
	// BEGIN GENERATED hit
	switch name {
	case "home.start":
		return x >= -224 && x <= -54 && y >= 46 && y <= 96
	case "home.coop":
		return x >= -224 && x <= -54 && y >= -2 && y <= 36
	case "home.maker":
		return x >= -224 && x <= -54 && y >= -46 && y <= -8
	case "ed.t1":
		return x >= 102 && x <= 126 && y >= 110 && y <= 134
	case "ed.t2":
		return x >= 126.5 && x <= 150.5 && y >= 110 && y <= 134
	case "ed.t3":
		return x >= 151 && x <= 175 && y >= 110 && y <= 134
	case "ed.t4":
		return x >= 175.5 && x <= 199.5 && y >= 110 && y <= 134
	case "ed.t5":
		return x >= 200 && x <= 224 && y >= 110 && y <= 134
	case "ed.mirror":
		return x >= 104 && x <= 220 && y >= 74 && y <= 92
	case "ed.play":
		return x >= 104 && x <= 220 && y >= 8 && y <= 30
	case "ed.play2":
		return x >= 104 && x <= 220 && y >= -16 && y <= 2
	case "ed.rand":
		return x >= 104 && x <= 220 && y >= -38 && y <= -20
	case "ed.copy":
		return x >= 104 && x <= 220 && y >= -60 && y <= -42
	case "ed.clear":
		return x >= 104 && x <= 220 && y >= -82 && y <= -64
	case "ed.save":
		return x >= 104 && x <= 220 && y >= -104 && y <= -86
	case "ed.back":
		return x >= 104 && x <= 220 && y >= -126 && y <= -108
	case "revive.ad":
		return x >= -162 && x <= 18 && y >= -32 && y <= -4
	case "revive.giveup":
		return x >= -127 && x <= -17 && y >= -88 && y <= -66
	case "result.ad":
		return x >= -162 && x <= 18 && y >= -12 && y <= 14
	case "result.again":
		return x >= -162 && x <= 18 && y >= -54 && y <= -24
	case "result.home":
		return x >= -117 && x <= -27 && y >= -90 && y <= -68
	case "card.close":
		return x >= 206 && x <= 222 && y >= -86 && y <= -70
	case "card":
		return x >= 102 && x <= 222 && y >= -156 && y <= -70
	case "banner.close":
		return x >= 202 && x <= 224 && y >= -168 && y <= -136
	case "banner":
		return x >= -224 && x <= 224 && y >= -168 && y <= -136
	}
	// END GENERATED hit
	return false
}

// ---------- 数字 ----------

// 数字宽度和逗号宽度（由 tools/assets/build.py 生成，和造型保持一致）
func widths(st string) (float64, float64) {
	// BEGIN GENERATED widths
	if st == "S" {
		return 10.782, 6.084
	}
	if st == "B" {
		return 4.792, 2.704
	}
	if st == "C" {
		return 8.386, 4.732
	}
	// END GENERATED widths
	return 0, 0
}

// 12450 -> "12,450"
func withCommas(n int) string {
	s := strconv.Itoa(n)
	out := ""
	for i := 0; i < len(s); i++ {
		if i > 0 && (len(s)-i)%3 == 0 {
			out += ","
		}
		out += s[i : i+1]
	}
	return out
}

func refreshNumber() {
	s := withCommas(score)
	st := "S"
	if kind == kBest {
		s = withCommas(best)
		st = "B"
	} else if kind == kCoin {
		s = withCommas(coins)
		st = "C"
		if state != stResult {
			hide
			return
		}
	}
	if slot >= len(s) {
		hide
		return
	}
	dw, cw := widths(st)
	total := 0.0
	off := 0.0
	for i := 0; i < len(s); i++ {
		w := dw
		if s[i:i+1] == "," {
			w = cw
		}
		if i < slot {
			off += w
		}
		total += w
	}
	x := baseX + off
	if kind == kBest {
		x = baseX - total + off // 最高分右对齐
	}
	ch := s[slot : slot+1]
	if ch == "," {
		ch = "comma"
	}
	setCostume st + ch
	setXYpos x, baseY
	show
}

// ---------- 刷新 ----------

func refresh() {
	switch kind {
	case kLabel:
		k := key
		if key == "stage" && stage == customStage {
			k = "stage.custom"
			if coop {
				k += ".co"
			}
		} else if key == "stage" {
			k = "stage." + strconv.Itoa(stage) // 关卡名随关卡变化
			if coop {
				k += ".co" // 带「双人」标签
			}
		} else if coop && key == "hint.move" {
			k = "hint.p1"
		} else if coop && key == "hint.fire" {
			k = "hint.p2"
		} else if !coop && (key == "tag.1p" || key == "tag.2p") {
			hide
			return
		} else if touchUI && strings.HasPrefix(key, "hint.") {
			hide // 触屏模式：按键说明的位置换成方向键
			return
		}
		setCostume k + "_" + langCode()
		show
	case kScore, kBest, kCoin:
		refreshNumber
	case kPip:
		if slot < killed {
			setCostume "pip_off"
		} else {
			setCostume "pip_on"
		}
		show
	case kLife:
		if slot < lives {
			setCostume "life_on"
		} else {
			setCostume "life_off"
		}
		x := 110.0
		if coop {
			x = 124 // 双人时左边留出「1P」标签的位置
		}
		setXYpos x+float64(slot)*16, 68
		show
	case kLife2:
		if !coop {
			hide
			return
		}
		if slot < lives2 {
			setCostume "life2_on"
		} else {
			setCostume "life2_off"
		}
		show
	case kLang:
		if state == stAd {
			hide // 播放广告时不显示，避免挡住广告
		} else {
			setCostume "toggle_" + langCode()
			show
		}
	case kToast:
		if left > 0 {
			setCostume key + "_" + langCode()
		}
	case kAd:
		// 原生广告卡在对局、复活询问、结算时显示，横幅只在主页显示；播放激励视频时都不显示。玩家关掉后不再出现
		card := key == "card" && (state == stPlay || state == stRevive || state == stResult) && !cardClosed
		banner := key == "banner" && state == stHome && !bannerClosed
		if card || banner {
			setCostume key + "_" + langCode()
			show
		} else {
			hide
		}
	case kEdSel, kEdSwitch, kEdStatus, kEdCursor, kEdMark:
		refreshEditor
	case kTouchPad:
		if touchUI && (state == stPlay || state == stRevive || state == stResult) {
			setCostume "touchpad_" + langCode()
			show
		} else {
			hide
		}
	case kScreen:
		if screen == "" {
			hide
		} else {
			setCostume screen + "_" + langCode()
			show
		}
	}
}

// 编辑器小部件：位置和造型跟着舞台的编辑状态走
func refreshEditor() {
	if state != stEdit {
		hide
		return
	}
	switch kind {
	case kEdSel:
		setCostume "edsel"
		setXYpos 114+float64(edTool-1)*24.5, 122
	case kEdSwitch:
		if slot == 1 {
			if !edMirror {
				hide
				return
			}
			setCostume "edline"
		} else if edMirror {
			setCostume "edsw_on"
		} else {
			setCostume "edsw_off"
		}
	case kEdStatus:
		if edProblem == 0 {
			setCostume "edok_" + langCode()
		} else {
			setCostume "edbad" + strconv.Itoa(edProblem) + "_" + langCode()
		}
	case kEdCursor, kEdMark:
		i := edCursor
		if kind == kEdMark {
			i = edMark
		}
		if i < 0 {
			hide
			return
		}
		if kind == kEdMark {
			setCostume "edmark"
		} else {
			setCostume "edcursor"
		}
		setXYpos cellX(i%cols), cellY(i/cols)
	}
	setLayer Front
	show
}

// 点击广告位：关闭按钮关掉广告，其他位置模拟打开广告主页
func clickAd() {
	x := mouseX
	y := mouseY
	if hit(key+".close", x, y) {
		if key == "card" {
			cardClosed = true
		} else {
			bannerClosed = true
		}
		hide
		return
	}
	toast "msg.adclick", 1.5
}

// 点击全屏 / 弹窗画面上的按钮
func clickScreen() {
	x := mouseX
	y := mouseY
	switch state {
	case stHome:
		if hit("home.start", x, y) {
			newGame 1, false
		} else if hit("home.coop", x, y) {
			newGame 1, true
		} else if hit("home.maker", x, y) {
			openEditor
		}
	case stEdit:
		for n := 1; n <= 5; n++ {
			if hit("ed.t"+strconv.Itoa(n), x, y) {
				edTool = n
				broadcast "edit"
				return
			}
		}
		for _, c := range []string{"mirror", "play", "play2", "rand", "copy", "clear", "save", "back"} {
			if hit("ed."+c, x, y) {
				edCommand c
				return
			}
		}
	case stRevive:
		if hit("revive.ad", x, y) {
			watchAd rewardRevive
		} else if hit("revive.giveup", x, y) {
			endGame false
		}
	case stResult:
		if hit("result.ad", x, y) && !doubled {
			watchAd rewardDouble
		} else if hit("result.again", x, y) {
			again
		} else if hit("result.home", x, y) {
			goHome
		}
	}
}

// ---------- 事件 ----------

onCloned => {
	refresh
	if kind != kToast {
		return
	}
	// 提示条：到时间自动隐藏
	for {
		waitNextFrame
		if left > 0 {
			left -= deltaTime
			if left <= 0 {
				hide
			}
		}
	}
}

onMsg "hud", => {
	if isCloned {
		refresh
	}
}

onMsg "langChanged", => {
	if isCloned {
		refresh
	}
}

// 画面切换：画面层移到最前，然后（"raise"）再把广告位、语言按钮、提示条放到画面之上
onMsg "screen", => {
	if isCloned {
		refresh
		if kind == kScreen {
			setLayer Front
		}
	}
}

// 编辑状态变了（工具、对称、检查结果）
onMsg "edit", => {
	if isCloned && kind >= kEdSel && kind <= kEdMark {
		refreshEditor
	}
}

onMsg "edCursor", => {
	if isCloned && kind == kEdCursor {
		refreshEditor
	}
}

onMsg "raise", => {
	if isCloned && (kind == kAd || kind == kLang || kind == kToast || kind == kCoin) {
		setLayer Front
	}
}

// 显示提示条，内容在舞台的 toastKey / toastSecs 里
onMsg "toast", => {
	if isCloned && kind == kToast {
		key = toastKey
		left = toastSecs
		if state == stHome {
			setXYpos 0, -118 // 主页：菜单和横幅之间的空白处
		} else {
			setXYpos -72, 20 // 战场上方
		}
		refresh
		setLayer Front
		show
	}
}

onClick => {
	if !isCloned {
		return
	}
	switch kind {
	case kLang:
		switchLang
	case kAd:
		clickAd
	case kScreen, kEdSel, kEdSwitch, kEdStatus, kEdCursor, kEdMark:
		clickScreen // 编辑器的小部件盖在按钮上面，点击时按鼠标位置判断按了什么
	}
}
