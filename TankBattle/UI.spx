import (
	"strconv"
	"strings"
)

// 所有界面元素（标签、数字、图标、语言按钮、提示条、广告位、弹窗画面）都是 UI 的克隆，用 kind 区分。
//
// 为什么这样写：spx 解释器（本地 spx run 和 XBuilder 网页版共用）的方法表有全局上限 2560。
// 实测发现，每出现一种“新的字段总大小”的精灵类型，就要多占约 110 个位置，v1 已经接近上限。
// 所以 UI 的字段总大小固定为 56 字节（和 Enemy 相同）：不要随意增删字段，新功能请复用下面这几个。
// 详见 docs/ARCHITECTURE.md 的「解释器方法表上限」。
var (
	kind  int     // 见下面的 kind 常量
	key   string  // 标签 / 提示条：文案 key，造型名是 "<key>_<语言>"；广告位："card" 或 "banner"
	slot  int     // 数字：第几个字符；图标：第几个
	baseX float64 // 数字：锚点
	baseY float64
	left  float64 // 提示条：还要显示多久（秒）
)

const (
	kLabel = 1 // 文字标签
	kScore = 2 // 得分的一个字符位（大号白色，左对齐）
	kBest  = 3 // 最高分的一个字符位（小号金色，右对齐）
	kPip   = 4 // 顶栏的敌军剩余格子
	kLife  = 5 // 生命图标
	kLang  = 6 // 中 | EN 语言按钮
	kToast  = 7  // 提示条
	kAd     = 8  // 广告位：对局中的原生广告卡（key "card"）或主页横幅（key "banner"）
	kScreen = 9  // 全屏 / 弹窗画面：主页、选关、复活、模拟广告、结算（造型名在舞台的 screen 里）
	kCoin   = 10 // 结算弹窗里金币数的一个字符位（金色，左对齐）
	kLife2  = 11 // 2P 的生命图标（只在双人时显示）

	// 地图编辑器的小部件（只在编辑器里显示）
	kEdSel    = 12 // 当前工具的选中框
	kEdSwitch = 13 // slot 0：对称开关；slot 1：战场中间的对称线
	kEdStatus = 14 // 检查结果
	kEdCursor = 15 // 鼠标所在的格子
	kEdMark   = 16 // 出问题的格子

	kTouchPad = 17 // 触屏模式的方向键（手机 App 里替换右侧的按键说明）
	kPauseBtn = 18 // 顶栏的暂停按钮
	kAlly     = 19 // v6 敌我区分：我方坦克脚下的光圈和头顶的“1P · Lv3”标签（slot 1 是 1P，2 是 2P），每帧跟着坦克走
	kChip     = 20 // v6 右侧面板的芯片格：slot 0~2 是 1P 的三个位置，3~5 是 2P 的
	kPick     = 21 // v6 三选一：slot 0~2 是三张卡片，3 是刷新按钮，4 是“1P / 2P”标签（双人时）
	kDrop     = 22 // v6 战场上掉落的芯片（精英被击毁后出现，每帧跟着舞台的 dropX / dropY）
	kGarage   = 23 // v6 车库里会变的部分：slot 0 指挥官等级，1 经验条，2 下一个解锁，3 涂装预览，10~21 芯片图鉴，30~34 涂装，40~42 任务，43~45 任务进度
	kWallet   = 24 // v6 车库里金币数的一个字符位（金色，左对齐）
	kDailyTag = 25 // v6 每日挑战结算时弹窗上方的标签：正式成绩 / 练习
	kRanks    = 26 // v6 排行榜画面：slot 0~1 选项卡，2 范围说明，3 状态（读取中 / 离线 / 没上线 / 没人上榜），10~33 每行的芯片，40~47 每行的底，48 “我的名次”
	kLbNum    = 27 // v6 排行榜里数字的一个字符位：slot = 行 × 100 + 第几个数字 × 10 + 第几个字符（见舞台的 lbText）
)

// ---------- 创建 ----------

// 文字标签，(x, y) 是文字锚点（造型里已经按左 / 中 / 右对齐设好）
func label(x, y float64, k string) {
	kind = kLabel
	key = k
	setXYpos x, y
	clone
}

// 数字，k 是 kScore 或 kBest，最多 n 个字符，每个字符位一个克隆
func number(k int, x, y float64, n int) {
	kind = k
	baseX = x
	baseY = y
	for i := 0; i < n; i++ {
		slot = i
		clone
	}
}

// 排行榜里的一个数字（v6）：n 个字符位，slot 从 base 开始（base = 行 × 100 + 第几个数字 × 10）
func lbNum(x, y float64, base, n int) {
	kind = kLbNum
	baseX = x
	baseY = y
	for i := 0; i < n; i++ {
		slot = base + i
		clone
	}
}

// 图标，k 是 kPip 或 kLife
func icon(k int, x, y float64, i int) {
	kind = k
	slot = i
	setXYpos x, y
	clone
}

func langButton(x, y float64) {
	kind = kLang
	setXYpos x, y
	clone
}

func toastBar(x, y float64) {
	kind = kToast
	setXYpos x, y
	clone
}

// 广告位，k 是 "card" 或 "banner"
func adSlot(x, y float64, k string) {
	kind = kAd
	key = k
	setXYpos x, y
	clone
}

func screenLayer() {
	kind = kScreen
	setXYpos 0, 0
	clone
}

// ---------- 点击区域 ----------

// (x, y) 是否在按钮 name 的范围内（由 tools/assets/build.py 生成，和画面保持一致）
func hit(name string, x, y float64) bool {
	// BEGIN GENERATED hit
	switch name {
	case "pick.1":
		return x >= -194 && x <= -74 && y >= -62 && y <= 88
	case "pick.2":
		return x >= -60 && x <= 60 && y >= -62 && y <= 88
	case "pick.3":
		return x >= 74 && x <= 194 && y >= -62 && y <= 88
	case "pick.reroll":
		return x >= -95 && x <= 95 && y >= -110 && y <= -86
	case "gr.sk.1":
		return x >= -224 && x <= -194 && y >= -66 && y <= -36
	case "gr.sk.2":
		return x >= -190 && x <= -160 && y >= -66 && y <= -36
	case "gr.sk.3":
		return x >= -156 && x <= -126 && y >= -66 && y <= -36
	case "gr.sk.4":
		return x >= -122 && x <= -92 && y >= -66 && y <= -36
	case "gr.sk.5":
		return x >= -88 && x <= -58 && y >= -66 && y <= -36
	case "gr.back":
		return x >= -224 && x <= -114 && y >= -160 && y <= -136
	case "lb.tab.1":
		return x >= -224 && x <= -132 && y >= 118 && y <= 138
	case "lb.tab.2":
		return x >= -126 && x <= -34 && y >= 118 && y <= 138
	case "lb.back":
		return x >= 114 && x <= 224 && y >= 118 && y <= 138
	case "home.start":
		return x >= -224 && x <= -54 && y >= 46 && y <= 96
	case "home.coop":
		return x >= -224 && x <= -54 && y >= -2 && y <= 36
	case "home.maker":
		return x >= -224 && x <= -54 && y >= -46 && y <= -8
	case "home.levels":
		return x >= -224 && x <= -54 && y >= -90 && y <= -52
	case "home.daily":
		return x >= -14 && x <= 60 && y >= -126 && y <= -82
	case "home.garage":
		return x >= 68 && x <= 142 && y >= -126 && y <= -82
	case "home.ranks":
		return x >= 150 && x <= 224 && y >= -126 && y <= -82
	case "lv.1":
		return x >= -224 && x <= -120 && y >= 16 && y <= 100
	case "lv.2":
		return x >= -112 && x <= -8 && y >= 16 && y <= 100
	case "lv.3":
		return x >= 0 && x <= 104 && y >= 16 && y <= 100
	case "lv.4":
		return x >= 112 && x <= 216 && y >= 16 && y <= 100
	case "lv.5":
		return x >= -224 && x <= -120 && y >= -76 && y <= 8
	case "lv.6":
		return x >= -112 && x <= -8 && y >= -76 && y <= 8
	case "lv.7":
		return x >= 0 && x <= 104 && y >= -76 && y <= 8
	case "lv.8":
		return x >= 112 && x <= 216 && y >= -76 && y <= 8
	case "lv.back":
		return x >= -224 && x <= -114 && y >= -122 && y <= -96
	case "pause.resume":
		return x >= -162 && x <= 18 && y >= -8 && y <= 22
	case "pause.restart":
		return x >= -162 && x <= 18 && y >= -46 && y <= -20
	case "pause.home":
		return x >= -122 && x <= -22 && y >= -86 && y <= -64
	case "ed.t1":
		return x >= 102 && x <= 126 && y >= 110 && y <= 134
	case "ed.t2":
		return x >= 126.5 && x <= 150.5 && y >= 110 && y <= 134
	case "ed.t3":
		return x >= 151 && x <= 175 && y >= 110 && y <= 134
	case "ed.t4":
		return x >= 175.5 && x <= 199.5 && y >= 110 && y <= 134
	case "ed.t5":
		return x >= 200 && x <= 224 && y >= 110 && y <= 134
	case "ed.mirror":
		return x >= 104 && x <= 220 && y >= 74 && y <= 92
	case "ed.play":
		return x >= 104 && x <= 220 && y >= 8 && y <= 30
	case "ed.play2":
		return x >= 104 && x <= 220 && y >= -16 && y <= 2
	case "ed.rand":
		return x >= 104 && x <= 220 && y >= -38 && y <= -20
	case "ed.copy":
		return x >= 104 && x <= 220 && y >= -60 && y <= -42
	case "ed.clear":
		return x >= 104 && x <= 220 && y >= -82 && y <= -64
	case "ed.save":
		return x >= 104 && x <= 220 && y >= -104 && y <= -86
	case "ed.back":
		return x >= 104 && x <= 220 && y >= -126 && y <= -108
	case "revive.ad":
		return x >= -162 && x <= 18 && y >= -32 && y <= -4
	case "revive.giveup":
		return x >= -127 && x <= -17 && y >= -88 && y <= -66
	case "result.ad":
		return x >= -162 && x <= 18 && y >= -12 && y <= 14
	case "result.again":
		return x >= -162 && x <= 18 && y >= -54 && y <= -24
	case "result.home":
		return x >= -117 && x <= -27 && y >= -90 && y <= -68
	case "card.close":
		return x >= 206 && x <= 222 && y >= -86 && y <= -70
	case "card":
		return x >= 102 && x <= 222 && y >= -156 && y <= -70
	case "banner.close":
		return x >= 202 && x <= 224 && y >= -168 && y <= -136
	case "banner":
		return x >= -224 && x <= 224 && y >= -168 && y <= -136
	}
	// END GENERATED hit
	return false
}

// ---------- 数字 ----------

// 数字宽度和逗号宽度（由 tools/assets/build.py 生成，和造型保持一致）
func widths(st string) (float64, float64) {
	// BEGIN GENERATED widths
	if st == "S" {
		return 10.782, 6.084
	}
	if st == "B" {
		return 4.792, 2.704
	}
	if st == "C" {
		return 8.386, 4.732
	}
	if st == "L" {
		return 4.492, 2.535
	}
	// END GENERATED widths
	return 0, 0
}

// 12450 -> "12,450"
func withCommas(n int) string {
	s := strconv.Itoa(n)
	out := ""
	for i := 0; i < len(s); i++ {
		if i > 0 && (len(s)-i)%3 == 0 {
			out += ","
		}
		out += s[i : i+1]
	}
	return out
}

func refreshNumber() {
	s := withCommas(score)
	st := "S"
	idx := slot // 这是数字的第几个字符
	right := kind == kBest
	if kind == kLbNum {
		if state != stRanks {
			hide
			return
		}
		field := (slot / 10) % 10
		s = lbText(slot/100, field)
		if n, err := strconv.Atoi(s); err == nil && field != 1 {
			s = withCommas(n) // 指挥官编号不加千分位
		}
		st = "L"
		idx = slot % 10
		right = field != 1 // 指挥官编号左对齐，其余右对齐
	} else if kind == kBest {
		s = withCommas(best)
		st = "B"
	} else if kind == kCoin {
		s = withCommas(coins)
		st = "C"
		if state != stResult {
			hide
			return
		}
	} else if kind == kWallet {
		s = withCommas(wallet)
		st = "C"
		if state != stGarage {
			hide
			return
		}
	}
	if idx >= len(s) {
		hide
		return
	}
	dw, cw := widths(st)
	total := 0.0
	off := 0.0
	for i := 0; i < len(s); i++ {
		w := dw
		if s[i:i+1] == "," {
			w = cw
		}
		if i < idx {
			off += w
		}
		total += w
	}
	x := baseX + off
	if right {
		x = baseX - total + off // 右对齐（最高分、排行榜的名次和分数）
	}
	ch := s[idx : idx+1]
	if ch == "," {
		ch = "comma"
	}
	setCostume st + ch
	setXYpos x, baseY
	show
}

// ---------- 刷新 ----------

func refresh() {
	switch kind {
	case kLabel:
		k := key
		if touchUI && strings.HasPrefix(key, "hint.") {
			hide // 触屏模式：按键说明的位置换成方向键（双人的按键说明也不显示）
			return
		}
		if key == "stage" && stage == dailyStage {
			k = "stage.daily"
		} else if key == "stage" && stage == customStage {
			k = "stage.custom"
			if coop {
				k += ".co"
			}
		} else if key == "stage" {
			k = "stage." + strconv.Itoa(stage) // 关卡名随关卡变化
			if coop {
				k += ".co" // 带「双人」标签
			}
		} else if coop && key == "hint.move" {
			k = "hint.p1"
		} else if coop && key == "hint.fire" {
			k = "hint.p2"
		} else if !coop && (key == "tag.1p" || key == "tag.2p" || key == "tag.c1" || key == "tag.c2") {
			hide
			return
		} else if touchUI && (key == "chips" || key == "tag.c1" || key == "tag.c2") {
			hide // 触屏模式：芯片格的位置是方向键（等级看坦克头顶的标签）
			return
		}
		setCostume k + "_" + langCode()
		show
	case kScore, kBest, kCoin, kWallet, kLbNum:
		refreshNumber
	case kRanks:
		refreshRanks
	case kGarage:
		refreshGarage
	case kPip:
		if slot < killed {
			setCostume "pip_off"
		} else if slot >= totalEnemy-(eliteCount()-elitesKilled) {
			setCostume "pip_elite" // 还没击毁的精英（v6）排在最后，紫色
		} else {
			setCostume "pip_on"
		}
		show
	case kChip:
		refreshChip
	case kDailyTag:
		if state != stResult || stage != dailyStage {
			hide
			return
		}
		if dailyOfficial {
			setCostume "dtag_off_" + langCode()
		} else {
			setCostume "dtag_prac_" + langCode()
		}
		setLayer Front
		show
	case kPick:
		refreshPick
	case kLife:
		c := lifeLook(lives, slot, false)
		if c == "" {
			hide
			return
		}
		setCostume c
		x := 110.0
		if coop {
			x = 124 // 双人时左边留出「1P」标签的位置
		}
		setXYpos x+float64(slot)*16, 68
		show
	case kLife2:
		if !coop {
			hide
			return
		}
		c := lifeLook(lives2, slot, true)
		if c == "" {
			hide
			return
		}
		setCostume c
		show
	case kLang:
		if state == stAd {
			hide // 播放广告时不显示，避免挡住广告
		} else {
			setCostume "toggle_" + langCode()
			show
		}
	case kToast:
		if left > 0 {
			setCostume key + "_" + langCode()
		}
	case kAd:
		// 原生广告卡在对局、复活询问、结算时显示，横幅只在主页显示；播放激励视频时都不显示。玩家关掉后不再出现
		card := key == "card" && (state == stPlay || state == stRevive || state == stResult || state == stPause) && !cardClosed
		banner := key == "banner" && state == stHome && !bannerClosed
		if card || banner {
			setCostume key + "_" + langCode()
			show
		} else {
			hide
		}
	case kEdSel, kEdSwitch, kEdStatus, kEdCursor, kEdMark:
		refreshEditor
	case kPauseBtn:
		if state == stPlay && !autopilot {
			setCostume "pausebtn"
			show
		} else {
			hide
		}
	case kTouchPad:
		if touchUI && (state == stPlay || state == stRevive || state == stResult) {
			setCostume "touchpad_" + langCode()
			show
		} else {
			hide
		}
	case kScreen:
		if screen == "" {
			hide
		} else {
			setCostume screen + "_" + langCode()
			show
		}
	}
}

// 我方标识：对局中（含暂停）跟着自己的坦克；坦克死了、2P 不在、不在对局里就隐藏。
// 返回现在是否显示。刚出现时放到最前面（盖住草丛，玩家藏进草丛也知道自己在哪）；
// 之后不再改图层，所以暂停、结算的弹窗出现时会盖住它
func allyStep(shown bool) bool {
	on, x, y := allyAt(slot)
	if !on {
		if shown {
			hide
		}
		return false
	}
	setXYpos x, y
	c := "ally_" + strconv.Itoa(slot) + "_" + strconv.Itoa(lvl[slot]) // 等级变了才换造型（key 记着当前的造型）
	if c != key {
		key = c
		setCostume c
	}
	if !shown {
		setLayer Front
		show
	}
	return true
}

// 战场上的芯片：对局中（含暂停）显示在 dropX / dropY，最后 3 秒闪烁
func dropStep(shown bool) bool {
	if dropLeft <= 0 || (state != stPlay && state != stPause) {
		if shown {
			hide
		}
		return false
	}
	setXYpos dropX, dropY
	if dropLeft < 3 && int(dropLeft*6)%2 == 0 {
		setGraphicEffect GhostEffect, 70
	} else {
		clearGraphicEffects
	}
	if !shown {
		setCostume "drop"
		setLayer Front
		show
	}
	return true
}

// 右侧面板的芯片格：第 slot/3+1 个玩家的第 slot%3 个位置。触屏模式（方向键在这里）和单人时的 2P 行不显示
func refreshChip() {
	who := slot/3 + 1
	i := slot % 3
	if touchUI || (who == 2 && !coop) {
		hide
		return
	}
	c := "ci_empty"
	if i < len(chips[who]) {
		c = "ci_" + chipKey(chips[who][i])
	}
	setCostume c
	x := 111.0 + float64(i)*17
	if coop {
		x += 16 // 左边留出「1P / 2P」标签
	}
	y := 22.0
	if who == 2 {
		y = 6
	}
	setXYpos x, y
	show
}

// 排行榜画面会变的部分（只在排行榜里显示）。图层在 "raise" / "raiseTop" 里调：每行的底在下，数字和芯片在上
func refreshRanks() {
	if state != stRanks {
		hide
		return
	}
	ok := lbStatus == lbOK
	c := ""
	switch {
	case slot <= 1:
		on := "off"
		if slot == lbTab {
			on = "on"
		}
		c = "lbtab_" + strconv.Itoa(slot) + "_" + on + "_" + langCode()
	case slot == 2:
		c = "lbscope_" + strconv.Itoa(lbTab) + "_" + langCode()
	case slot == 3:
		if ok && len(lbTags) > 0 {
			hide
			return
		}
		if ok {
			c = "lbst_empty_" + langCode()
		} else {
			c = "lbst_" + strconv.Itoa(lbStatus) + "_" + langCode()
		}
	case slot >= 10 && slot < 40:
		row, j := (slot-10)/3, (slot-10)%3
		if !ok || row >= len(lbChips) || j >= len(lbChips[row]) {
			hide
			return
		}
		c = "ci_" + chipKey(lbChips[row][j])
	case slot >= 40 && slot <= 47:
		row := slot - 40
		if !ok || row >= len(lbTags) {
			hide
			return
		}
		medal, me := 0, 0
		if row < 3 {
			medal = row + 1
		}
		if lbMine[row] {
			me = 1
		}
		c = "lbrow_" + strconv.Itoa(medal) + "_" + strconv.Itoa(me) + "_" + langCode()
	case slot == 48:
		if !ok {
			hide
			return
		}
		if lbMyRank == 0 {
			c = "lbme_none_" + langCode()
		} else {
			c = "lbme_" + langCode()
		}
	}
	setCostume c
	show
}

// 车库里会变的部分（只在车库里显示）
func refreshGarage() {
	if state != stGarage {
		hide
		return
	}
	c := ""
	switch {
	case slot == 0:
		c = "cmd_" + strconv.Itoa(cmdLevel) + "_" + langCode()
	case slot == 1:
		have, need := xpInLevel()
		c = "xp_" + strconv.Itoa(have*20/need)
	case slot == 2:
		if nextUnlock() == 0 {
			c = "nx_all_" + langCode()
		} else {
			c = "nx_" + chipKey(nextUnlock()) + "_" + langCode()
		}
	case slot == 3:
		c = "skp_" + strconv.Itoa(skin)
	case slot >= 10 && slot <= 21:
		id := slot - 9
		if chipUnlocked(id) {
			c = "cx_" + chipKey(id) + "_" + langCode()
		} else {
			c = "cxl_" + chipKey(id) + "_" + langCode()
		}
	case slot >= 30 && slot <= 34:
		i := slot - 30
		if i == skin {
			c = "sk_" + strconv.Itoa(i) + "_sel"
		} else if skinsOwned[i] {
			c = "sk_" + strconv.Itoa(i) + "_own"
		} else {
			c = "sk_" + strconv.Itoa(i) + "_lock"
		}
	case slot >= 40 && slot <= 42:
		i := slot - 40
		k := taskIDs[i]
		done := "0"
		if taskProg[i] >= taskTarget(k) {
			done = "1"
		}
		c = "tk_" + strconv.Itoa(k) + "_" + done + "_" + langCode()
	case slot >= 43 && slot <= 45:
		i := slot - 43
		k := taskIDs[i]
		c = "tp_" + strconv.Itoa(taskProg[i]*10/taskTarget(k))
	}
	setCostume c
	setLayer Front
	show
}

// 三选一的卡片、刷新按钮、谁在选（只在三选一时显示）
func refreshPick() {
	if state != stPick {
		hide
		return
	}
	if slot <= 2 {
		if slot >= len(pickOpts) {
			hide
			return
		}
		id := pickOpts[slot]
		c := "pc_" + chipKey(id)
		if pickCombo(id) {
			c += "_combo"
		}
		setCostume c + "_" + langCode()
	} else if slot == 3 {
		setCostume "reroll_" + rerollLook() + "_" + langCode()
	} else {
		if !coop {
			hide
			return
		}
		setCostume "pickwho_" + strconv.Itoa(pickWho)
	}
	setLayer Front
	show
}

// 编辑器小部件：位置和造型跟着舞台的编辑状态走
func refreshEditor() {
	if state != stEdit {
		hide
		return
	}
	switch kind {
	case kEdSel:
		setCostume "edsel"
		setXYpos 114+float64(edTool-1)*24.5, 122
	case kEdSwitch:
		if slot == 1 {
			if !edMirror {
				hide
				return
			}
			setCostume "edline"
		} else if edMirror {
			setCostume "edsw_on"
		} else {
			setCostume "edsw_off"
		}
	case kEdStatus:
		if edProblem == 0 {
			setCostume "edok_" + langCode()
		} else {
			setCostume "edbad" + strconv.Itoa(edProblem) + "_" + langCode()
		}
	case kEdCursor, kEdMark:
		i := edCursor
		if kind == kEdMark {
			i = edMark
		}
		if i < 0 {
			hide
			return
		}
		if kind == kEdMark {
			setCostume "edmark"
		} else {
			setCostume "edcursor"
		}
		setXYpos cellX(i%cols), cellY(i/cols)
	}
	setLayer Front
	show
}

// 点击广告位：关闭按钮关掉广告，其他位置模拟打开广告主页
func clickAd() {
	x := mouseX
	y := mouseY
	if hit(key+".close", x, y) {
		if key == "card" {
			cardClosed = true
		} else {
			bannerClosed = true
		}
		hide
		return
	}
	toast "msg.adclick", 1.5
}

// 点击全屏 / 弹窗画面上的按钮
func clickScreen() {
	x := mouseX
	y := mouseY
	switch state {
	case stHome:
		if hit("home.start", x, y) {
			newGame 1, false
		} else if hit("home.coop", x, y) {
			newGame 1, true
		} else if hit("home.maker", x, y) {
			openEditor
		} else if hit("home.levels", x, y) {
			openLevels
		} else if hit("home.garage", x, y) {
			openGarage
		} else if hit("home.daily", x, y) {
			playDaily
		} else if hit("home.ranks", x, y) {
			openRanks
		}
	case stRanks:
		if hit("lb.tab.1", x, y) {
			lbShow 0
		} else if hit("lb.tab.2", x, y) {
			lbShow 1
		} else if hit("lb.back", x, y) {
			goHome
		}
	case stGarage:
		for n := 0; n < skinCount; n++ {
			if hit("gr.sk."+strconv.Itoa(n+1), x, y) {
				buySkin n
				return
			}
		}
		if hit("gr.back", x, y) {
			goHome
		}
	case stLevels:
		for n := 1; n <= lastStage; n++ {
			if hit("lv."+strconv.Itoa(n), x, y) {
				newGame n, false
				return
			}
		}
		if hit("lv.back", x, y) {
			goHome
		}
	case stPause:
		if hit("pause.resume", x, y) {
			resumeGame
		} else if hit("pause.restart", x, y) {
			startGame
		} else if hit("pause.home", x, y) {
			quitFromPause
		}
	case stEdit:
		for n := 1; n <= 5; n++ {
			if hit("ed.t"+strconv.Itoa(n), x, y) {
				edTool = n
				broadcast "edit"
				return
			}
		}
		for _, c := range []string{"mirror", "play", "play2", "rand", "copy", "clear", "save", "back"} {
			if hit("ed."+c, x, y) {
				edCommand c
				return
			}
		}
	case stRevive:
		if hit("revive.ad", x, y) {
			watchAd rewardRevive
		} else if hit("revive.giveup", x, y) {
			endGame false
		}
	case stPick:
		for n := 1; n <= 3; n++ {
			if hit("pick."+strconv.Itoa(n), x, y) {
				pickChoose(n - 1)
				return
			}
		}
		if hit("pick.reroll", x, y) {
			pickReroll
		}
	case stResult:
		if hit("result.ad", x, y) && !doubled {
			watchAd rewardDouble
		} else if hit("result.again", x, y) {
			again
		} else if hit("result.home", x, y) {
			goHome
		}
	}
}

// ---------- 事件 ----------

onCloned => {
	uiClones++
	if kind == kAlly || kind == kDrop {
		shown := false
		for {
			waitNextFrame
			if kind == kAlly {
				shown = allyStep(shown)
			} else {
				shown = dropStep(shown)
			}
		}
	}
	refresh
	if kind != kToast {
		return
	}
	// 提示条：到时间自动隐藏
	for {
		waitNextFrame
		if left > 0 {
			left -= deltaTime
			if left <= 0 {
				hide
			}
		}
	}
}

// 离开车库、排行榜这些画面：它们的小部件删掉，把克隆的名额让给地图和敌人（全部精灵最多 300 个克隆）
onMsg "panelOff", => {
	if isCloned && (kind == kGarage || kind == kWallet || kind == kRanks || kind == kLbNum) {
		uiClones--
		destroy
	}
}

onMsg "hud", => {
	if isCloned {
		refresh
	}
}

onMsg "langChanged", => {
	if isCloned {
		refresh
	}
}

// 画面切换：画面层移到最前，然后（"raise"）再把广告位、语言按钮、提示条放到画面之上
onMsg "screen", => {
	if isCloned {
		refresh
		if kind == kScreen {
			setLayer Front
		}
	}
}

// 编辑状态变了（工具、对称、检查结果）
onMsg "edit", => {
	if isCloned && kind >= kEdSel && kind <= kEdMark {
		refreshEditor
	}
}

onMsg "edCursor", => {
	if isCloned && kind == kEdCursor {
		refreshEditor
	}
}

onMsg "raise", => {
	if isCloned && (kind == kAd || kind == kLang || kind == kToast || kind == kCoin || kind == kPick || kind == kGarage || kind == kWallet || kind == kDailyTag || (kind == kRanks && (slot < 10 || slot >= 40))) {
		setLayer Front
	}
}

// 第二层：排行榜的数字和芯片要在每行的底上面（"raise" 之后再广播）
onMsg "raiseTop", => {
	if isCloned && (kind == kLbNum || (kind == kRanks && slot >= 10 && slot < 40)) {
		setLayer Front
	}
}

// 显示提示条，内容在舞台的 toastKey / toastSecs 里
onMsg "toast", => {
	if isCloned && kind == kToast {
		key = toastKey
		left = toastSecs
		if state == stHome {
			setXYpos 0, -118 // 主页：菜单和横幅之间的空白处
		} else {
			setXYpos -72, 20 // 战场上方
		}
		refresh
		setLayer Front
		show
	}
}

onClick => {
	if !isCloned {
		return
	}
	switch kind {
	case kLang:
		switchLang
	case kAd:
		clickAd
	case kPauseBtn:
		pauseGame
	case kScreen, kEdSel, kEdSwitch, kEdStatus, kEdCursor, kEdMark:
		clickScreen // 编辑器的小部件盖在按钮上面，点击时按鼠标位置判断按了什么
	}
}
