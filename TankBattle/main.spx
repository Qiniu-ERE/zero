}

// 排行榜第 row 行第 field 个数字：n 个字符位，(x, y) 是锚点（右对齐的是右端）
func lbNumber(row, field int, x, y float64, n int) {
	UI.lbNum x, y, row*100+field*10, n
}

// 生命图标第 slot 个（0~2）的造型：有 n 条命，p2 表示 2P 的图标；"" 表示不显示。
// 超过 3 条命（复活后可能有 4 条）显示成“图标 ×N”：第 2 个位置是 ×N，第 3 个不显示
func lifeLook(n, slot int, p2 bool) string {
	name := "life"
	if p2 {
		name = "life2"
	}
	if n > 3 && slot == 1 {
		return "lifex" + strconv.Itoa(int(math.Min(float64(n), 9)))
	}
	if n > 3 && slot == 2 {
		return ""
	}
	if slot < n {
		return name + "_on"
	}
	return name + "_off"
}

func baseLook() string {
	if baseDown {
		return look("broken")
	}
	return look("eagle")
}

// 切换画风：舞台换背景，其他精灵收到 "themeChanged" 后各自换造型
func switchTheme() {
	theme = 1 - theme
	setBackdrop look("field")
	broadcast "themeChanged"
	if theme == 1 {
		toast "msg.modern", 1.2
	} else {
		toast "msg.classic", 1.2
	}
}

// 现代画风下的震屏（由爆炸触发）
func shake(power float64) {
	if theme == 1 && !camBusy {
		shakePower = power
		broadcast "shake"
	}
}

// 砖墙要打两下：第一下裂开，第二下才碎（和原版一样，基地不会太快被打穿）
// 砖墙精灵收到 "gridChanged" 后会自己对照 grid 更新（同一帧打中两块砖也不会漏掉）
func breakBrick(i int) {
	if grid[i] == 1 {
		grid[i] = 3
	} else {
		grid[i] = 0
	}
	broadcast "gridChanged"
}

// 子弹的某个检测点碰到东西了吗？碰到砖墙会把砖打碎
// byPlayer：是不是玩家的子弹（和原版一样，只有玩家的子弹打墙才有声音）
func hitPoint(x, y float64, byPlayer bool) bool {
	i := cellIndex(x, y)
	if i < 0 {
		return true
	}
	switch grid[i] {
	case 1, 3:
		breakBrick(i)
		if byPlayer {
			sfx "brick"
		}
		return true
	case 2:
		if byPlayer && hasChip(shooter, cPierce) { // 穿甲弹：钢墙一发打掉
			grid[i] = 0
			broadcast "gridChanged"
			sfx "brick"
			return true
		}
		if byPlayer {
			sfx "steel"
		}
		return true
	case 9:
		if !autopilot && baseSafe <= 0 { // 路演演示时基地不会被打掉，由演示脚本安排“防线失守”；刚复活时有几秒保护
			baseDestroyed()
		}
		return true
	}
	return false
}

// 在 (x, y) 处朝 d 方向飞行的子弹是否撞到了墙、基地或边界
// 弹头左右各有一个检测点，所以一发子弹可以同时打掉并排的两块砖
func bulletHit(x, y float64, d int, byPlayer bool) bool {
	fx := x + dirDX(d)*3
	fy := y + dirDY(d)*3
	px := dirDY(d) * 6
	py := dirDX(d) * 6
	a := hitPoint(fx+px, fy+py, byPlayer)
	// 两个检测点落在同一格时只算一次：否则正对一块砖打，一发就会扣两下（砖墙应该打两下才碎）
	i := cellIndex(fx+px, fy+py)
	if i >= 0 && i == cellIndex(fx-px, fy-py) {
		return a
	}
	b := hitPoint(fx-px, fy-py, byPlayer)
	return a || b
}

// ---------- 流程：主页 → 对局 → (复活询问 → 激励视频) → 结算 ----------

// 切换全屏 / 弹窗画面。先让画面层到最前，再把广告位、语言按钮和提示条放到它上面
func setScreen(name string) {
	screen = name
	broadcastAndWait "screen"
	broadcastAndWait "raise"
	broadcast "raiseTop" // 排行榜的数字和芯片在每行的底上面（v6）
}

func goHome() {
	state = stHome
	panelOff()
	autopilot = false
	gameOver = true
	broadcastAndWait "clear"
	if p2Exists {
		broadcastAndWait "p2off"
	}
	stopAllSounds
	Camera.setZoom 1
	Camera.setXYpos 0, 0
	setScreen "home"
}

// 战败（基地被毁或生命用完）：每局第一次战败时询问是否看视频复活
func defeat() {
	if gameOver {
		return
	}
	gameOver = true
	if revived {
		endGame false
		return
	}
	state = stRevive
	broadcast "reviveFlow"
}

// 开始播放激励视频，reward 是看完后的奖励
func watchAd(reward int) {
	if state == stAd {
		return
	}
	state = stAd
	adReward = reward
	broadcast "adFlow"
}

// 复活：修复基地、额外 1 条命，玩家回到出生点并获得出生保护。
// 同时清场：敌人子弹和基地附近的敌人消失（不算击毁，以后重新出场），补回护墙，基地 3 秒内打不掉。
// 否则贴在基地旁的敌人一解冻就能再打掉基地，复活就白费了
func revive() {
	revived = true
	reviveStage = stage
	if baseDown {
		baseDown = false
		grid[baseIdx] = 9
		broadcast "baseChanged"
	}
	broadcastAndWait "reviveClear"
	if fortifyLeft > 0 {
		endFortify() // 先把钢铁堡垒恢复成砖墙，下面再按地图补护墙
	}
	m := levelMap()
	for _, i := range []int{baseIdx - cols - 1, baseIdx - cols, baseIdx - cols + 1, baseIdx - 1, baseIdx + 1} {
		if m[i/cols][i%cols] != 'B' || grid[i] == 1 {
			continue
		}
		if grid[i] == 0 {
			Tile.build cellX(i%cols), cellY(i/cols), 1, i // 碎掉的砖重新摆上；裂开的砖收到 gridChanged 后自己换造型
		}
		grid[i] = 1
	}
	broadcast "gridChanged"
	broadcast "baseGuard"
	lives++
	if coop {
		lives2++
	}
	broadcast "hud"
	Camera.setZoom 1
	Camera.setXYpos 0, 0
	state = stPlay
	setScreen ""
	Player.respawn
	if coop {
		broadcast "p2respawn"
	}
	gameOver = false
	toast "msg.revived", 1.5
	if killed >= totalEnemy {
		endGame true // 最后一辆敌人和基地在同一帧被打掉：复活后直接过关
	}
}

func endGame(win bool) {
	gameOver = true
	won = win
	state = stResult
	coins = (score - stageScore) / 50 // 按本关得分折算（得分会带到下一关，不能重复算）
	if win {
		coins += 100
	}
	if autopilot {
		coins = 0 // 路演演示的金币不进钱包
	}
	wallet += coins // v6：存进钱包，车库里买涂装
	if win {
		gainXP xpClear
		if stage <= lastStage {
			taskAdd tkClear, 1
			gainSeason ptsClear
		}
	}
	if stage == customStage {
		taskAdd tkCustom, 1
	}
	if stage == dailyStage && !autopilot {
		dailyEnd win
	}
	lbAfterGame()
	if coop {
		taskAdd tkCoop, 1
	}
	saveGame()
	doubled = false
	resultReady = false
	broadcast "resultArm"
	broadcast "gameEnd"
	showResult
}

func showResult() {
	name := "result_lose_"
	if stage == customStage {
		name = "result_elose_" // 自制地图试玩：继续编辑
		if won {
			name = "result_ewin_"
		}
	} else if won && stage == dailyStage {
		name = "result_dwin_" // 每日挑战赢了：按钮是“再来一局”（没有下一关）
	} else if won && stage == lastStage {
		name = "result_final_" // 全部通关
	} else if won {
		name = "result_win_"
	}
	if doubled {
		name += "done"
	} else {
		name += "plain"
	}
	setScreen name
	broadcast "hud" // 刷新金币数
}

// ---------- 暂停 ----------

// 对局中暂停：战场冻结，弹出暂停菜单
func pauseGame() {
	if state != stPlay || gameOver || autopilot { // gameOver：开局或复活还没准备好
		return
	}
	state = stPause
	gameOver = true // 坦克、子弹、出兵、重生倒计时都会停下来
	if stage == customStage {
		setScreen "pause_edit"
	} else {
		setScreen "pause"
	}
}

func resumeGame() {
	if state != stPause {
		return
	}
	state = stPlay
	setScreen ""
	gameOver = false
}

// 暂停菜单里的“返回”：自制地图回到编辑器，其他回到主页
func quitFromPause() {
	if dailyForfeit() {
		goHome // 正式局已经按放弃结算了
		return
	}
	if stage == customStage {
		openEditor
	} else {
		goHome
	}
}

// 暂停菜单的“重新开始本关”（R 或点按钮）
func restartFromPause() {
	if dailyForfeit() {
		again // 正式局已经按放弃结算，这一局是练习
		return
	}
	startGame
}

// 每日挑战的正式局（今天第一局）中途重来或回主页：按放弃结算，当前得分就是今天的正式成绩。
// 不然可以一直重来，直到打出满意的一局（“今天第一局是正式成绩”就没意义了）。返回是否结算了
func dailyForfeit() bool {
	if stage != dailyStage || autopilot || dailyDay == dailyDayNow {
		return false
	}
	endGame false
	return true
}

// 结算后的“再来一局”按钮（R）：赢了进下一关；全部通关后从第 1 关重新开始；输了重打本关
func again() {
	if stage == customStage {
		openEditor // 继续编辑
		return
	}
	if stage == dailyStage {
		if d := today(); d > 0 {
			dailyDayNow = d // 过了零点再来一局，打的是新一天的图（新一天的第一局是正式成绩）
		}
		reviveStage = 0
		clearRun()
		runSecs = 0
		startGame // 每日挑战再来一局（今天的正式成绩已经有了，这局是练习）
		return
	}
	if won && stage < lastStage {
		stage++
		stageScore = score
		snapRun() // 坦克等级和芯片带到下一关
	} else if won {
		stage = 1
		stageScore = 0
		clearRun()
	}
	reviveStage = 0 // 结算后的下一关、重打本关都可以再复活一次（只有暂停里的“重新开始本关”不清零）
	startGame
}

// 从主页开始新游戏：第 n 关，two 表示双人合作
func newGame(n int, two bool) {
	if two && touchUI {
		toast "msg.coop.touch", 2 // 手机 App 只认一根手指，2P 没法操作
		return
	}
	coop = two
	playStage n
}

// 打开选关画面（主页的“选择关卡”卡片）
func openLevels() {
	state = stLevels
	setScreen "levels"
}

// 从主页或选关画面进入第 n 关（得分从 0 开始）
func playStage(n int) {
	stage = n
	stageScore = 0
	reviveStage = 0 // 从主页进关：可以重新复活一次
	clearRun()      // 坦克等级从 Lv1 开始
	runSecs = 0
	startGame
}

// 确认键：主页开始、复活询问时看视频、结算时看视频翻倍
func confirm() {
	switch state {
	case stAssist:
		assistConfirm
	case stShare:
		panelOff()
		state = stResult
		showResult
	case stHome:
		newGame 1, false
	case stEdit:
		playCustom false
	case stPause:
		resumeGame
	case stRevive:
		// 基地被毁后要等 2.2 秒才弹出复活询问；这期间还在连按开火键（J / Enter），不能当成“看视频复活”
		if strings.HasPrefix(screen, "revive_") {
			watchAd rewardRevive
		}
	case stResult:
		if !resultReady {
			return // 结算刚出现，玩家可能还在按开火键
		}
		if !doubled {
			watchAd rewardDouble
		}
	}
}

// Esc：复活询问时放弃，编辑器里回主页，对局中暂停 / 继续（写成函数，测试可以直接调用）
func escKey() {
	if demoOn {
		demoStop = true
		broadcast "demoFlow" // 打断正在运行的演示，由新的处理收尾
		return
	}
	if state == stRevive {
		// 基地被毁后要等 2.2 秒才弹出复活询问；这期间按 Esc（本想暂停）不能当成“放弃复活”（和 confirm 一样）
		if strings.HasPrefix(screen, "revive_") {
			endGame false
		}
	} else if state == stEdit {
		goHome
	} else if state == stPlay {
		pauseGame
	} else if state == stPause {
		resumeGame
	} else if state == stLevels || state == stGarage || state == stRanks || state == stAssist {
		goHome
	} else if state == stShare {
		panelOff()
		state = stResult // 分享战报：回到结算
		showResult
	}
}

// ---------- 路演演示模式 ----------

// 敌人汇报自己的位置，自动驾驶只记住离玩家最近的那辆
func seeEnemy(x, y float64) {
	d := math.Abs(x-Player.xpos) + math.Abs(y-Player.ypos)
	if tgtAge > 0.3 || d < tgtDist {
		tgtX = x
		tgtY = y
		tgtDist = d
		tgtAge = 0
	}
}

// 自动驾驶选方向：先和最近的敌人对齐到同一行或同一列，然后朝它开（一直在开火，砖墙会被打穿）。
// 撞墙后随机绕一会儿路
func autopilotDir(dt float64) int {
	tgtAge += dt
	tgtDist += 60 * dt // 让旧目标慢慢“变远”，更近的敌人能接替
	if apTimer > 0 {
		apTimer -= dt
		return apDir
	}
	if tgtAge > 0.5 {
		return 0 // 暂时没有敌人：往上走
	}
	dx := tgtX - Player.xpos
	dy := tgtY - Player.ypos
	if math.Abs(dx) < 8 {
		if dy > 0 {
			return 0
		}
		return 180
	}
	if math.Abs(dy) < 8 || math.Abs(dx) < math.Abs(dy) {
		if dx > 0 {
			return 90
		}
		return -90
	}
	if dy > 0 {
		return 0
	}
	return 180
}

// 自动驾驶撞墙了：随机选个方向绕一会儿路
func autopilotBlocked() {
	if apTimer > 0 {
		return
	}
	n := int(rand(1, 4))
	if n == 1 {
		apDir = 0
	} else if n == 2 {
		apDir = 90
	} else if n == 3 {
		apDir = -90
	} else {
		apDir = 180
	}
	apTimer = rand(0.4, 0.9)
}

// 路演演示的 v3.0 部分：几个新关卡 → 双人合作 → 暂停菜单 → 地图编辑器里画一张“河流城堡”并试玩
// 路演演示的 v6 部分：精英掉的芯片 → 捡起来三选一 → 坦克升到 Lv2（头顶标签、右侧芯片格）→ 车库 → 每日挑战。
// 自动驾驶捡芯片时会直接装第一块（不弹三选一），所以这里由脚本摆出三选一画面，停一会儿再选第一块。
// 演示不进存档：自动驾驶时经验、金币、任务、赛季、每日挑战正式成绩都不算
func demoV6() {
	autopilot = true
	newGame 4, false // 第 4 关：钢铁堡垒，精英多
	apTimer = 0
	tgtAge = 9
	wait 3
	if state != stPlay {
		return
	}
	dropX = p1x // 精英刚掉下的芯片（就在 1P 前面）
	dropY = p1y + 34
	dropLeft = dropSecs
	broadcast "hud"
	wait 1.5
	if state == stPlay {
		dropLeft = 0
		pickWho = 1
		pickRoll()
		state = stPick
		gameOver = true
		sfx "start"
		setScreen "pick"
	}
	wait 3.5
	pickChoose 0
	wait 3.5
	goHome
	wait 1
	openGarage
	wait 3.5
	goHome
	wait 0.5
	autopilot = true
	playDaily
	apTimer = 0
	tgtAge = 9
	wait 5
}

func demoV3() {
	for _, n := range []int{2, 3, 4, 8} {
		autopilot = true
		newGame n, false
		apTimer = 0
		tgtAge = 9
		wait 3.5
	}
	autopilot = true
	newGame 1, true // 双人合作（演示时 1P 自动驾驶，2P 停在出生点）
	apTimer = 0
	tgtAge = 9
	wait 4
	autopilot = false
	pauseGame // 暂停菜单（Esc / 顶栏的 Ⅱ）
	wait 2.5
	resumeGame
	wait 0.5
	demoKeepEd = ed // 演示会清空编辑器，结束（或按 Esc 退出）后还原玩家的地图
	demoKeepLoaded = edLoaded
	demoEdSaved = true
	edLoaded = true // 演示时不读取玩家保存的地图
	openEditor
	edBlank()
	edMirror = true
	edTool = 1
	edRebuild()
	broadcast "edit"
	wait 1.5
	castle := []string{
		".............",
		".B.........B.",
		"...WWW.WWW...",
		"..W.......W..",
		"..W.SBBBS.W..",
		"....B...B....",
		"..W.B.S.B.W..",
		"..W.SB.BS.W..",
		"...WWW.WWW...",
		".B.........B.",
		".BB..B.B..BB.",
	}
	for r := 1; r < len(castle); r++ {
		for c := 0; c <= 6; c++ {
			ch := castle[r][c]
			if ch == '.' {
				continue
			}
			edTool = strings.IndexByte(".BSWG", ch) // 工具跟着换，右侧的选中框会动
			edPaint r*cols+c, ch
			edPaint r*cols+cols-1-c, ch // 对称绘制
			edCheck()
			broadcast "edit"
			wait 0.07
		}
	}
	wait 1.5
	autopilot = true
	playCustom false
	apTimer = 0
	tgtAge = 9
	wait 6
	restoreDemoEd()
}

// 还原演示前玩家在编辑器里的地图
func restoreDemoEd() {
	if demoEdSaved {
		ed = demoKeepEd
		edLoaded = demoKeepLoaded
		demoEdSaved = false
	}
}

// 按 Esc 退出演示：关掉自动驾驶，还原编辑器地图、画风和语言，回到主页
func stopDemo() {
	demoStop = false
	demoOn = false
	autopilot = false
	restoreDemoEd()
	if theme != demoTheme {
		switchTheme
	}
	if lang != demoLang {
		switchLang
	}
	goHome
}

// 等到画面进入状态 st（最多等 secs 秒），用于演示脚本按实际状态推进
func waitState(st int, secs float64) {
	for secs > 0 && state != st {
		wait 0.2
		secs -= 0.2
	}
}

func baseDestroyed() {
	if gameOver {
		return
	}
	baseDown = true
	broadcast "baseChanged"
	sfx "basefall"
	if theme == 1 {
		broadcast "baseCam"
	}
	Boom.explodeAt baseX, baseY, 1.5
	defeat
}

func enemyKilled(points int) {
	score += points
	killed++
	enemiesAlive--
	gainXP xpKill
	taskAdd tkKill, 1
	if score > best && !autopilot { // 路演演示（自动驾驶）的分数不算最高分
		best = score
	}
	broadcast "hud"
	if killed >= totalEnemy && !gameOver { // 基地已经在同一帧失守了：按战败处理（复活后再判胜利，见 revive）
		endGame true
	}
}

// 轮流在左上、中上、右上三个出生点放出敌人，坦克类型按本关配置随机
func spawnEnemy() {
	heavy, fast, _, _ := stageTune()
	c := (spawned % 3) * 6
	kind := 0 // 0 普通坦克，1 快速坦克，2 重型坦克
	n := int(rand(1, 100))
	if stage == dailyStage {
		n = dailyRand(100) + 1 // 每日挑战：敌人的类型和出场顺序大家一样
	}
	if n <= heavy {
		kind = 2
	} else if n <= heavy+fast {
		kind = 1
	}
	if eliteSlot(spawned) {
		kind += 10 // 精英（v6）：类型加 10，不给 Enemy 加字段（方法表上限）
		toast "msg.elite", 2
	}
	Enemy.spawn cellX(c), cellY(0), kind
	spawned++
	enemiesAlive++
}

// 根据 levelMap 生成砖墙、钢墙和基地（都是 Tile 的克隆）
func buildMap() {
	grid = make([]int, rows*cols)
	for r := 0; r < rows; r++ {
		line := levelMap()[r]
		for c := 0; c < cols; c++ {
			i := r*cols + c
			switch line[c] {
			case 'B':
				grid[i] = 1
				Tile.build cellX(c), cellY(r), 1, i
			case 'S':
				grid[i] = 2
				Tile.build cellX(c), cellY(r), 2, i
			case 'W':
				grid[i] = 4
				Tile.build cellX(c), cellY(r), 4, i
			case 'G':
				grid[i] = 5
				Tile.build cellX(c), cellY(r), 5, i
			case 'E':
				grid[i] = 9
				baseX = cellX(c)
				baseY = cellY(r)
				baseIdx = i
				Tile.build baseX, baseY, 9, i
			}
		}
	}
}

// v2 默认使用现代画风（按 T 可以切到 1985 经典像素风）
func initTheme() {
	theme = 1
	setBackdrop look("field")
}

func startGame() {
	gameOver = true // 先暂停，等地图搭好再开始
	broadcastAndWait "clear"
	stopAllSounds
	score = stageScore
	lives = 3
	lives2 = 3
	pbCount2 = 0
	spawned = 0
	enemiesAlive = 0
	killed = 0
	pbCount = 0
	baseDown = false
	revived = reviveStage == stage
	won = false
	baseSafe = 0
	resetRun()
	applyAssist()
	dailySeed = dailyDayNow*31 + 7
	dailyChipSeed = dailyDayNow*97 + 3
	dailySecs = 0
	if stage == dailyStage {
		runSecs = 0 // 上传的用时只算这一局（和分享卡片上的一致）
	}
	state = stPlay
	setScreen ""
	Camera.setZoom 1
	Camera.setXYpos 0, 0
	buildMap
	broadcast "hud"
	Player.respawn
	Player.fireHeld = true // 触屏：点“开始 / 再来一局”开局时手指还按着，先松开才开火
	if coop {
		if p2Exists {
			broadcast "p2respawn"
		} else {
			Player.spawnP2
		}
	} else if p2Exists {
		broadcastAndWait "p2off"
	}
	sfx "start"
	if coop && stage == 1 {
		toast "msg.coop", 3
	} else {
		toast stageTip(), 3
	}
	gameOver = false
}

onKey KeyT, => {
	switchTheme
}

onKey KeyL, => {
	switchLang
}

// 震屏：镜头快速抖动几下再回到中心
onMsg "shake", => {
	p := shakePower
	repeat 6, => {
		Camera.setXYpos rand(-p, p), rand(-p, p)
		wait 0.03
	}
	if !camBusy {
		Camera.setXYpos 0, 0
	}
}

// 现代画风下基地被摧毁：镜头推近特写
onMsg "baseCam", => {
	camBusy = true
	Camera.setXYpos baseX, baseY
	Camera.setZoom 1.8
	wait 2
	Camera.setZoom 1
	Camera.setXYpos 0, 0
	camBusy = false
}

onKey KeyEnter, => {
	confirm
}

onKey KeyJ, => {
	confirm
}

onKey KeySpace, => {
	if state == stHome {
		newGame 1, false
	}
}

// 主页按 C：双人合作；编辑器里 C 是清空
onKey KeyC, => {
	if state == stHome {
		newGame 1, true
	} else if state == stEdit {
		edCommand "clear"
	}
}

// 主页按 D：每日挑战（v6）
onKey KeyD, => {
	if state == stHome {
		playDaily
	}
}

// 主页按 A：输入好友的助战码（v6）
onKey KeyA, => {
	openAssist
}

onKey [Key0, Key9], (key) => {
	if key == Key0 {
		assistKey 0
	} else {
		assistKey 9
	}
}

onKey KeyBackspace, => {
	assistKey -1
}

// 主页按 B：排行榜（v6）
onKey KeyB, => {
	openRanks
}

// 主页按 G：车库（v6）
onKey KeyG, => {
	openGarage
}

// 主页按 E：自己做地图
onKey KeyE, => {
	if state == stHome {
		openEditor
	}
}

onKey KeyM, => {
	edCommand "mirror"
}

onKey KeyK, => {
	edCommand "copy"
}

// 编辑器里 S 是保存；每日挑战结算后 S 是分享战报（v6）
onKey KeyS, => {
	if state == stResult {
		openShare
	} else {
		edCommand "save"
	}
}

// 主页和选关画面按 1~8 直接进入对应关卡
onKey [Key1, Key2, Key3, Key4, Key5, Key6, Key7, Key8], (key) => {
	n := int(key) - int(Key0)
	if state == stPick {
		pickChoose(n - 1) // 三选一
	} else if state == stGarage {
		buySkin(n - 1) // 车库：换 / 买涂装
	} else if state == stRanks && n <= 2 {
		lbShow(n - 1) // 排行榜：切换选项卡
	} else if state == stAssist {
		assistKey n // 助战码
	} else if state == stHome || state == stLevels {
		newGame n, false
	} else if state == stEdit && n <= 5 {
		edTool = n // 编辑器：选工具
		broadcast "edit"
	}
}

onKey KeyEscape, => {
	escKey
}

onKey KeyR, => {
	if state == stPick {
		pickReroll
	} else if state == stResult {
		again
	} else if state == stPause {
		restartFromPause // 重新开始本关
	} else if state == stEdit {
		edCommand "rand"
	}
}

onKey KeyP, => {
	if state == stHome {
		broadcast "demoFlow"
	} else if state == stEdit {
		edCommand "play2"
	}
}

onKey KeyH, => {
	if state == stResult || state == stGarage || state == stRanks {
		goHome
	} else if state == stPause {
		quitFromPause
	}
}

// 编辑器：鼠标 / 触屏绘制。按住拖动可以连续画；对称绘制时右边同时画
onMsg "editLoop", => {
	// 点按钮进入编辑器时，点击在鼠标按下时就触发了；先等松开，否则会在按钮下面那格画上东西
	for mousePressed && state == stEdit {
		waitNextFrame
	}
	for state == stEdit {
		i := cellIndex(mouseX, mouseY)
		if i != edCursor {
			edCursor = i
			broadcast "edCursor"
		}
		if mousePressed && i >= 0 {
			ch := edToolChar(edTool)
			changed := edPaint(i, ch)
			if edMirror {
				j := (i/cols)*cols + (cols - 1 - i%cols)
				if edPaint(j, ch) {
					changed = true
				}
			}
			if changed {
				edCheck()
				broadcast "edit"
			}
		}
		waitNextFrame
	}
}

// 复活后的基地保护倒计时（暂停、复活询问时不算）
onMsg "baseGuard", => {
	baseSafe = 3
	for baseSafe > 0 {
		waitNextFrame
		if !gameOver {
			baseSafe -= deltaTime
		}
	}
}

onMsg "resultArm", => {
	wait 0.6
	resultReady = true
}

// 复活询问：倒计时结束还没选择就直接结算
onMsg "reviveFlow", => {
	wait 2.2 // 先让爆炸和镜头特写播完
	for n := reviveSeconds; n >= 1; n-- {
		if state != stRevive {
			return
		}
		setScreen "revive_" + strconv.Itoa(n)
		wait 1
	}
	if state == stRevive {
		endGame false
	}
}

// 模拟的激励视频：倒计时结束后发放奖励（正式版接入 Google H5 Games Ads）
onMsg "adFlow", => {
	for n := adSeconds; n >= 1; n-- {
		setScreen "adplay_" + strconv.Itoa(n)
		wait 1
		if state != stAd {
			return // 播放中离开了（例如演示中按 Esc 回到主页）：不发奖励
		}
	}
	if adReward == rewardRevive {
		revive
	} else if adReward == rewardReroll {
		rerollUsed = true
		pickRoll()
		state = stPick
		setScreen "pick"
	} else {
		wallet += coins // 翻倍多出来的那一份也存进钱包
		coins *= 2
		doubled = true
		saveGame()
		state = stResult
		showResult
	}
}

// 路演演示：对局（自动驾驶）→ 切画风 → 切语言 → 防线失守 → 看视频复活 → 胜利 → 看视频翻倍
// → v6.0：芯片掉落、三选一升级、车库、每日挑战（demoV6）
// → v3.0：新关卡、双人合作、自己做地图（demoV3）→ 回主页。
// 每一步都按实际状态推进：如果对局中真的战败了，也会自然进入复活流程
onMsg "demoFlow", => {
	if demoStop {
		stopDemo
		return
	}
	demoOn = true
	demoTheme = theme
	demoLang = lang
	autopilot = true // 先设好，开局时顶栏就不会显示暂停按钮
	newGame 1, false
	autopilot = true
	apTimer = 0
	tgtAge = 9
	wait 2.5 // 开局提示放完再提示怎么退出
	toast "msg.demo", 3
	wait 6.5
	switchTheme // 经典画风（情怀）
	wait 4
	switchTheme // 回到现代画风
	wait 2
	switchLang // English
	wait 5
	switchLang // 中文
	wait 3
	if state == stPlay {
		baseDestroyed // 演示脚本安排的“防线失守”
	}
	waitState stRevive, 10
	wait 3
	if state == stRevive {
		watchAd rewardRevive
	}
	waitState stPlay, 10
	wait 7
	if state == stPlay {
		endGame true
	}
	waitState stResult, 5
	wait 3
	if state == stResult && !doubled {
		watchAd rewardDouble
	}
	waitState stResult, 10
	wait 4
	demoV6
	demoV3
	demoOn = false
	autopilot = false
	broadcast "demoDone"
}

onMsg "demoDone", => {
	goHome
}

// 游戏结束后，等爆炸声播完再放胜利 / 失败音乐
onMsg "gameEnd", => {
	wait 1.2
	if state != stResult {
		return // 已经重新开始或回到主页了
	}
	if won {
		sfx "win"
	} else {
		sfx "gameover"
	}
}

// v6 芯片：每帧的倒计时、磁吸和拾取（见 chipTick）。只在 onStart 里广播一次（再次广播会打断正在运行的处理）
onMsg "chipLoop", => {
	for {
		waitNextFrame
		dt := deltaTime
		if dt > 0.05 {
			dt = 0.05
		}
		chipTick dt
		lbPoll
	}
}

onStart => {
	stage = 1
	initSave
	lbBase = lbURL
	if lbBase != "" {
		lbFlush() // 上次没传上去的成绩
		if nowSec() <= 0 {
			go lbHealth(lbBase) // 网页版：问服务器今天是第几天
		}
	}
	broadcast "chipLoop"
	initTheme
	buildHud
	goHome
	for {
		_, _, gap, maxAlive := stageTune()
		if coop { // 双人火力翻倍，敌人来得更快、场上更多
			gap *= 0.85
			maxAlive++
		}
		wait gap
		if !gameOver && spawned < totalEnemy && enemiesAlive < maxAlive {
			spawnEnemy
		}
	}
}
