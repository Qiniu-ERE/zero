import (
	"math"
	"strconv"
	"strings"
)

var (
	grid         []int // 地图格子：0 空地，1 砖墙，2 钢墙，3 裂开的砖墙，4 水面，5 草丛，9 基地
	score        int   // 得分
	best         int   // 本次运行的最高分
	lives        int   // 玩家剩余生命
	enemiesLeft  int   // 还需要消灭的敌人数量
	spawned      int   // 已经出场的敌人数量
	enemiesAlive int   // 场上活着的敌人数量
	killed       int   // 已消灭的敌人数量
	pbCount      int   // 场上玩家子弹数量（经典玩法：同时只能有 1 发）
	gameOver     bool  // 游戏是否结束
	won          bool  // 是否胜利
	theme        int   // 画风：0 经典像素，1 现代 3D 风格（按 T 切换）
	lang         int   // 语言：0 中文，1 English（按 L 或点右上角切换）
	toastKey     string  // 提示条要显示的文案 key
	toastSecs    float64 // 提示条显示多久
	baseDown     bool  // 基地是否已被摧毁
	camBusy      bool  // 镜头特写进行中（此时不震屏）
	shakePower   float64
	baseX        float64 // 基地位置（基地是 Tile 的一个克隆）
	baseY        float64
	baseIdx      int     // 基地所在的格子编号（复活时修复基地用）
	stage        int     // 当前关卡：1…lastStage
	stageScore   int     // 进入本关时的得分（重打本关时从这里开始）

	// AI 造关（见 docs/v3/AI_LEVELS.md）
	aiRows    []string // AI 关卡的地图
	aiTheme   int      // 0 自己描述（没有识别出主题），1~6 主题
	aiPrompt  string   // 玩家输入的描述
	aiBusy    bool     // XBuilder 版的 AIMaker 精灵正在请求大模型
	aiByModel bool     // 这张地图是大模型设计的（否则是本地程序化生成）

	// 流程与广告（见 docs/ARCHITECTURE.md 的「游戏流程」）
	state        int    // 当前画面：stHome / stPlay / stRevive / stAd / stResult
	screen       string // 全屏 / 弹窗画面的造型名（不含语言后缀），"" 表示不显示
	revived      bool   // 本局是否已经复活过（每局只能复活一次）
	coins        int    // 本局获得的金币
	doubled      bool   // 金币是否已经通过看视频翻倍
	adReward     int    // 正在播放的激励视频对应的奖励：rewardRevive / rewardDouble
	cardClosed   bool   // 玩家关掉了对局中的原生广告卡
	bannerClosed bool   // 玩家关掉了主页横幅

	// 路演演示模式（主页按 P）：玩家坦克自动驾驶，脚本依次展示各项功能
	autopilot bool
	apDir     int     // 自动驾驶绕路时的方向
	apTimer   float64 // 还要绕路多久（撞墙后随机走一会儿）
	tgtX      float64 // 最近一辆敌人的位置（敌人每帧通过 seeEnemy 汇报）
	tgtY      float64
	tgtDist   float64
	tgtAge    float64 // 距离上次汇报过了多久，太久说明目标已经没了
)

const (
	stHome   = 0 // 主页
	stPlay   = 1 // 对局中
	stRevive = 2 // 询问是否看视频复活
	stAd     = 3 // 正在播放（模拟的）激励视频
	stResult = 4 // 结算
	stAIMaker = 5 // AI 造关页面：选主题或自己描述
	stAIInput = 6 // 正在底部的输入框里输入描述
	stAIThink = 7 // AI 正在设计地图

	rewardRevive = 1 // 激励视频奖励：复活
	rewardDouble = 2 // 激励视频奖励：金币翻倍

	adSeconds     = 5 // 模拟激励视频的时长
	reviveSeconds = 7 // 复活询问的倒计时
)

const (
	cols       = 13     // 地图列数
	rows       = 13     // 地图行数
	fieldLeft  = -228.0 // 战场左边界
	fieldTop   = 150.0  // 战场上边界
	totalEnemy = 20     // 每关敌人总数
	lastStage  = 8      // 关卡总数
	aiStage    = 9      // AI 关卡的编号（不在 1~lastStage 里）
)

// 关卡地图（13 x 13，每格 24 像素）
// . 空地   B 砖墙（可打碎）   S 钢墙（打不碎）   W 水面（坦克过不去，子弹能飞过）   G 草丛（能藏身）   E 基地（老鹰）
// 规则：第 0 行的第 0、6、12 列是敌人出生点，第 12 行第 4 列是玩家出生点，都必须是空地；基地固定在第 12 行第 6 列。
// 改完地图运行 python3 tools/levels/check.py 检查（出生点、连通性等）
func levelMap() []string {
	if stage == aiStage && len(aiRows) == rows {
		return aiRows
	}
	switch stage {
	case 2: // 水乡迷宫：大片水面分割战场，坦克要绕路，子弹却能隔河对射
		return []string{
			".............",
			".B.B.....B.B.",
			".B.B.WWW.B.B.",
			"......B......",
			"WWW.BBBBB.WWW",
			".............",
			".BB.WW.WW.BB.",
			".BB.......BB.",
			"WW..B.S.B..WW",
			"....B...B....",
			".WW.......WW.",
			".....BBB.....",
			".....BEB.....",
		}
	case 3: // 丛林伏击：草丛遍地，快速坦克从草里冲出来
		return []string{
			".............",
			".GGG.B.B.GGG.",
			".GBG.B.B.GBG.",
			".GGG.....GGG.",
			"...GGG.GGG...",
			"BB.G.BSB.G.BB",
			"...G.....G...",
			".GGGGB.BGGGG.",
			".G.........G.",
			".G.BB.G.BB.G.",
			"GG.B.GGG.B.GG",
			"G....BBB....G",
			"G....BEB....G",
		}
	case 4: // 钢铁堡垒：钢墙林立，重型坦克为主
		return []string{
			".............",
			".S.S.SSS.S.S.",
			".S.S.....S.S.",
			"...B.S.S.B...",
			"SS.B.....B.SS",
			"...BSS.SSB...",
			".B.........B.",
			".B.SSB.BSS.B.",
			".B.........B.",
			"SSB.B.S.B.BSS",
			"...B.....B...",
			"..S..BBB..S..",
			"..S..BEB..S..",
		}
	case 5: // 砖城巷战：密集的砖墙街区，要自己打出一条路
		return []string{
			".............",
			".BBB.BBB.BBB.",
			".B.B.B.B.B.B.",
			".BBB.B.B.BBB.",
			".............",
			"BB.BBB.BBB.BB",
			"...B.....B...",
			".B.B.BBB.B.B.",
			".B...B.B...B.",
			".BBB.B.B.BBB.",
			".............",
			".BB..BBB..BB.",
			".B...BEB...B.",
		}
	case 6: // 闪电突袭：开阔地，敌军出动更快、快速坦克更多
		return []string{
			".............",
			".............",
			"..S.......S..",
			"....B...B....",
			".............",
			"GG..S.B.S..GG",
			".............",
			"WW..S.B.S..WW",
			".............",
			"....B...B....",
			"..S.......S..",
			".....BBB.....",
			".....BEB.....",
		}
	case 7: // 双子要塞：左右两座砖堡，中间一道水渠，小心交叉火力
		return []string{
			".............",
			".SBBS...SBBS.",
			".B..B...B..B.",
			".B..B.G.B..B.",
			".SB.S...S.BS.",
			"......W......",
			"GG.B..W..B.GG",
			"......W......",
			".BB.S...S.BB.",
			"..B.......B..",
			"B...B.S.B...B",
			".....BBB.....",
			".....BEB.....",
		}
	case 8: // 最终决战：各种地形都有，出兵最密集
		return []string{
			".............",
			".B.S.B.B.S.B.",
			".B.S.B.B.S.B.",
			".B...GGG...B.",
			"...WW...WW...",
			"SB.WW.S.WW.BS",
			"...GG...GG...",
			".BB..BBB..BB.",
			".B..B...B..B.",
			"GG..B.S.B..GG",
			"...SB...BS...",
			"...S.BBB.S...",
			"...S.BEB.S...",
		}
	}
	// 第 1 关：钢铁峡谷
	return []string{
		".............",
		".B.B.B.B.B.B.",
		".B.B.B.B.B.B.",
		".B.B.BSB.B.B.",
		".B.B.....B.B.",
		"GG...B.B...GG",
		"SS.BB...BB.SS",
		"WW...B.B...WW",
		".B.B.BBB.B.B.",
		".B.B.B.B.B.B.",
		".B.B.....B.B.",
		".B.B.BBB.B.B.",
		".....BEB.....",
	}
}

// 本关的敌军配置：重型坦克占比（%）、快速坦克占比（%）、出兵间隔（秒）、场上最多几辆
func stageTune() (int, int, float64, int) {
	if stage == aiStage {
		switch aiTheme {
		case 1:
			return 20, 30, 2.0, 4
		case 2:
			return 40, 20, 2.0, 4
		case 3:
			return 10, 60, 1.8, 4
		case 4:
			return 30, 30, 1.8, 4
		case 5:
			return 10, 70, 1.4, 5
		}
		return 30, 40, 1.8, 4
	}
	switch stage {
	case 2:
		return 20, 30, 2.0, 4
	case 3:
		return 10, 60, 1.8, 4
	case 4:
		return 50, 10, 2.2, 4
	case 5:
		return 30, 30, 1.8, 4
	case 6:
		return 10, 70, 1.2, 5
	case 7:
		return 30, 50, 1.5, 5
	case 8:
		return 45, 45, 1.3, 5
	}
	return 20, 30, 2.0, 4
}

// 每关开始时的提示（文案 key 见 tools/assets/strings.py）
func stageTip() string {
	if stage == aiStage {
		if aiByModel {
			return "msg.ai.ready"
		}
		return "msg.ai.local"
	}
	if stage == 1 {
		return "msg.start"
	}
	return "msg.stage" + strconv.Itoa(stage)
}

// ---------- AI 造关：地图检查（和 tools/levels/check.py 相同的规则）与本地程序化生成 ----------

func tankCanPass(ch byte) bool {
	return ch == '.' || ch == 'G' || ch == 'B' // 砖墙能打掉，算作能通过
}

// 从 (r, c) 出发，坦克能到达哪些格子
func reachable(m []string, r0, c0 int) []bool {
	seen := make([]bool, rows*cols)
	seen[r0*cols+c0] = true
	queue := []int{r0*cols + c0}
	for len(queue) > 0 {
		i := queue[0]
		queue = queue[1:]
		r := i / cols
		c := i % cols
		for d := 0; d < 4; d++ {
			nr := r
			nc := c
			if d == 0 {
				nr--
			} else if d == 1 {
				nr++
			} else if d == 2 {
				nc--
			} else {
				nc++
			}
			if nr >= 0 && nr < rows && nc >= 0 && nc < cols && !seen[nr*cols+nc] && tankCanPass(m[nr][nc]) {
				seen[nr*cols+nc] = true
				queue = append(queue, nr*cols+nc)
			}
		}
	}
	return seen
}

// 地图有什么问题，"" 表示合格。说明文字也会作为反馈发给大模型，让它改正
func mapProblem(m []string) string {
	if len(m) != rows {
		return "地图必须正好 13 行"
	}
	bases := 0
	for r := 0; r < rows; r++ {
		if len(m[r]) != cols {
			return "第 " + strconv.Itoa(r) + " 行必须正好 13 个字符"
		}
		for c := 0; c < cols; c++ {
			if !strings.ContainsRune(".BSWGE", rune(m[r][c])) {
				return "第 " + strconv.Itoa(r) + " 行有不认识的字符，只能用 . B S W G E"
			}
			if m[r][c] == 'E' {
				bases++
			}
		}
	}
	if bases != 1 || m[12][6] != 'E' {
		return "基地 E 必须有且只有一个，在第 12 行第 6 列"
	}
	if m[0][0] != '.' || m[0][6] != '.' || m[0][12] != '.' {
		return "第 0 行第 0、6、12 列是敌人出生点，必须是 ."
	}
	if m[12][4] != '.' {
		return "第 12 行第 4 列是玩家出生点，必须是 ."
	}
	for _, ch := range []byte{m[11][6], m[12][5], m[12][7]} {
		if ch == 'S' || ch == 'W' {
			return "基地上方和左右两格不能是钢墙 S 或水面 W"
		}
	}
	player := reachable(m, 12, 4)
	for _, c := range []int{0, 6, 12} {
		if !player[c] {
			return "玩家从出生点开不到第 0 行第 " + strconv.Itoa(c) + " 列的敌人出生点"
		}
		s := reachable(m, 0, c)
		if !s[11*cols+6] && !s[12*cols+5] && !s[12*cols+7] {
			return "从第 0 行第 " + strconv.Itoa(c) + " 列的出生点到不了基地（被钢墙或水面堵死了）"
		}
	}
	return ""
}

// 从玩家的描述里认出主题：1 河流 2 钢铁 3 草丛 4 砖城 5 开阔，认不出返回 0
func themeOf(p string) int {
	p = strings.ToLower(p)
	keys := []string{
		"河 水 湖 海 护城 river water lake moat sea",
		"钢 铁 金属 steel iron metal",
		"草 丛 林 森 树 grass forest jungle bush tree",
		"砖 城 迷宫 巷 brick maze city street",
		"开阔 空旷 平原 open field plain",
	}
	for i, line := range keys {
		for _, w := range strings.Fields(line) {
			if strings.Contains(p, w) {
				return i + 1
			}
		}
	}
	return 0
}

// 各主题的地形权重：砖、钢、水、草（%），以及奇数列 / 偶数列放墙的概率（%）
func themeWeights(t int) (int, int, int, int, int, int) {
	switch t {
	case 1:
		return 40, 10, 45, 5, 45, 25
	case 2:
		return 45, 50, 0, 5, 50, 20
	case 3:
		return 30, 5, 0, 65, 55, 35
	case 4:
		return 90, 10, 0, 0, 70, 30
	}
	return 55, 30, 5, 10, 25, 5 // 5 开阔战场
}

func pickTile(wb, ws, ww int) string {
	n := rand(1, 100)
	if n <= wb {
		return "B"
	} else if n <= wb+ws {
		return "S"
	} else if n <= wb+ws+ww {
		return "W"
	}
	return "G"
}

func reversed(s string) string {
	out := ""
	for i := len(s) - 1; i >= 0; i-- {
		out += s[i : i+1]
	}
	return out
}

// 随机生成一张左右对称的地图（不保证合格）
func genTry(theme int) []string {
	t := theme
	if t < 1 || t > 5 {
		t = rand(1, 5) // 随机惊喜、没认出主题：随便选一种风格
	}
	wb, ws, ww, _, dOdd, dEven := themeWeights(t)
	m := []string{"............."}
	for r := 1; r <= 10; r++ {
		half := ""
		for c := 0; c <= 6; c++ {
			d := dEven
			if c%2 == 1 {
				d = dOdd
			}
			if rand(1, 100) <= d {
				half += pickTile(wb, ws, ww)
			} else {
				half += "."
			}
		}
		m = append(m, half+reversed(half[:6]))
	}
	side := func() string {
		out := ""
		for c := 0; c < 4; c++ {
			if rand(1, 100) <= dEven {
				out += pickTile(wb, ws, ww)
			} else {
				out += "."
			}
		}
		return out
	}
	a := side()
	b := side()
	m = append(m, a+".BBB."+reversed(a), b+".BEB."+reversed(b))
	return m
}

// 本地程序化生成：随机生成并检查，直到合格（通常几次之内），实在不行就用第 1 关
func genMap(theme int) []string {
	for try := 0; try < 80; try++ {
		m := genTry(theme)
		if mapProblem(m) == "" {
			return m
		}
	}
	keep := stage
	stage = 1
	m := levelMap()
	stage = keep
	return m
}

// 发给大模型的请求（XBuilder 版的 AIMaker 精灵使用，见 docs/v3/ai/AIMaker.spx）
func aiRequest() string {
	if aiPrompt != "" {
		return "玩家的描述：" + aiPrompt
	}
	themes := []string{"", "被护城河环绕的城堡", "钢墙夹出的走廊", "草丛很多、适合埋伏", "曲折的砖墙迷宫", "开阔、几乎无处可躲", "随便设计一张有趣的地图"}
	return "主题：" + themes[aiTheme]
}

// 进入 AI 造关页面
func openAIMaker() {
	state = stAIMaker
	autopilot = false
	gameOver = true
	broadcastAndWait "clear"
	stopAllSounds
	Camera.setZoom 1
	Camera.setXYpos 0, 0
	setScreen "aimaker"
}

// 开始设计地图：theme 是主题（0 表示自己描述且没认出主题），prompt 是玩家的描述
func startAI(theme int, prompt string) {
	if state != stAIMaker && state != stAIInput {
		return
	}
	aiTheme = theme
	aiPrompt = prompt
	state = stAIThink
	broadcast "aiFlow"
}

// 第 c 列格子中心的 x 坐标
func cellX(c int) float64 {
	return fieldLeft + 12 + float64(c*24)
}

// 第 r 行格子中心的 y 坐标
func cellY(r int) float64 {
	return fieldTop - 12 - float64(r*24)
}

// 点 (x, y) 所在格子的编号，出界返回 -1
func cellIndex(x, y float64) int {
	c := int(math.Floor((x - fieldLeft) / 24))
	r := int(math.Floor((fieldTop - y) / 24))
	if c < 0 || c >= cols || r < 0 || r >= rows {
		return -1
	}
	return r*cols + c
}

// 点 (x, y) 处是什么：0 空地，1 砖墙，2 钢墙，3 裂开的砖墙，9 基地，-1 出界
func cellAt(x, y float64) int {
	i := cellIndex(x, y)
	if i < 0 {
		return -1
	}
	return grid[i]
}

// 坦克（边长约 22 像素）中心在 (x, y) 时，是否会压到墙、基地或出界
func tankBlocked(x, y float64) bool {
	h := 11.0
	return blocksTank(cellAt(x-h, y-h)) || blocksTank(cellAt(x+h, y-h)) || blocksTank(cellAt(x-h, y+h)) || blocksTank(cellAt(x+h, y+h))
}

// 格子 v 能不能挡住坦克：空地和草丛能开过去，其他（包括水面和出界）都不行
func blocksTank(v int) bool {
	return v != 0 && v != 5
}

// 转弯时把坐标对齐到半格（12 像素），这样坦克才能顺利钻进 1 格宽的路
func snapX(x float64) float64 {
	return fieldLeft + math.Round((x-fieldLeft)/12)*12
}

func snapY(y float64) float64 {
	return fieldTop - math.Round((fieldTop-y)/12)*12
}

// 朝向 d（0 上，90 右，180 下，-90 左）对应的 x 方向
func dirDX(d int) float64 {
	if d == 90 {
		return 1
	}
	if d == -90 {
		return -1
	}
	return 0
}

// 朝向 d 对应的 y 方向
func dirDY(d int) float64 {
	if d == 0 {
		return 1
	}
	if d == 180 {
		return -1
	}
	return 0
}

// 根据当前画风取造型 / 音效的名字：经典用 "basic"，现代用 "basic_m"
func look(name string) string {
	if theme == 1 {
		return name + "_m"
	}
	return name
}

// 播放音效。统一由舞台来播放，这样子弹消失了声音也不会被打断
func sfx(name string) {
	play look(name)
}

// 循环播放（用于引擎声）
func sfxLoop(name string) {
	play look(name), true
}

// 当前语言代码，HUD 造型名用它做后缀："score_zh"、"score_en"
func langCode() string {
	if lang == 1 {
		return "en"
	}
	return "zh"
}

func switchLang() {
	lang = 1 - lang
	broadcast "langChanged"
	toast "msg.lang", 1.2
}

// 显示提示条（文案 key 见 tools/assets/strings.py 的 msg.*）
func toast(k string, secs float64) {
	toastKey = k
	toastSecs = secs
	broadcast "toast"
}

// 搭建 HUD。坐标都是舞台坐标（中心为原点，y 向上），和 tools/assets/build.py 的布局一致
func buildHud() {
	// 顶栏：关卡名、敌军剩余、语言按钮
	UI.label -228, 160, "stage" // 关卡名：造型是 "stage.<关卡号>_<语言>"
	UI.label -36, 160, "enemies"
	for i := 0; i < totalEnemy; i++ {
		UI.icon kPip, -29+float64(i)*5.8, 163, i
	}
	UI.langButton 208, 164
	// 右侧面板：得分、最高分、生命、按键提示
	UI.label 104, 140, "score"
	UI.number kScore, 104, 120, 9
	UI.label 104, 104, "best"
	UI.number kBest, 220, 104, 9
	UI.label 104, 80, "lives"
	for i := 0; i < 3; i++ {
		UI.icon kLife, 110+float64(i)*16, 68, i
	}
	UI.label 104, 46, "hint.move"
	UI.label 104, 30, "hint.fire"
	UI.label 104, 14, "hint.style"
	UI.label 104, -2, "hint.lang"
	// 广告位：对局中的原生广告卡、主页横幅
	UI.adSlot 162, -113, "card"
	UI.adSlot 0, -152, "banner"
	// 全屏 / 弹窗画面，以及结算弹窗里的金币数
	UI.screenLayer
	UI.number kCoin, -132, 35, 9
	// 战场上方的提示条
	UI.toastBar -72, 20
}

func baseLook() string {
	if baseDown {
		return look("broken")
	}
	return look("eagle")
}

// 切换画风：舞台换背景，其他精灵收到 "themeChanged" 后各自换造型
func switchTheme() {
	theme = 1 - theme
	setBackdrop look("field")
	broadcast "themeChanged"
	if theme == 1 {
		toast "msg.modern", 1.2
	} else {
		toast "msg.classic", 1.2
	}
}

// 现代画风下的震屏（由爆炸触发）
func shake(power float64) {
	if theme == 1 && !camBusy {
		shakePower = power
		broadcast "shake"
	}
}

// 砖墙要打两下：第一下裂开，第二下才碎（和原版一样，基地不会太快被打穿）
// 砖墙精灵收到 "gridChanged" 后会自己对照 grid 更新（同一帧打中两块砖也不会漏掉）
func breakBrick(i int) {
	if grid[i] == 1 {
		grid[i] = 3
	} else {
		grid[i] = 0
	}
	broadcast "gridChanged"
}

// 子弹的某个检测点碰到东西了吗？碰到砖墙会把砖打碎
// byPlayer：是不是玩家的子弹（和原版一样，只有玩家的子弹打墙才有声音）
func hitPoint(x, y float64, byPlayer bool) bool {
	i := cellIndex(x, y)
	if i < 0 {
		return true
	}
	switch grid[i] {
	case 1, 3:
		breakBrick(i)
		if byPlayer {
			sfx "brick"
		}
		return true
	case 2:
		if byPlayer {
			sfx "steel"
		}
		return true
	case 9:
		if !autopilot { // 路演演示时基地不会被打掉，由演示脚本安排“防线失守”
			baseDestroyed()
		}
		return true
	}
	return false
}

// 在 (x, y) 处朝 d 方向飞行的子弹是否撞到了墙、基地或边界
// 弹头左右各有一个检测点，所以一发子弹可以同时打掉并排的两块砖
func bulletHit(x, y float64, d int, byPlayer bool) bool {
	fx := x + dirDX(d)*3
	fy := y + dirDY(d)*3
	px := dirDY(d) * 6
	py := dirDX(d) * 6
	a := hitPoint(fx+px, fy+py, byPlayer)
	b := hitPoint(fx-px, fy-py, byPlayer)
	return a || b
}

// ---------- 流程：主页 → 对局 → (复活询问 → 激励视频) → 结算 ----------

// 切换全屏 / 弹窗画面。先让画面层到最前，再把广告位、语言按钮和提示条放到它上面
func setScreen(name string) {
	screen = name
	broadcastAndWait "screen"
	broadcast "raise"
}

func goHome() {
	state = stHome
	autopilot = false
	gameOver = true
	broadcastAndWait "clear"
	stopAllSounds
	Camera.setZoom 1
	Camera.setXYpos 0, 0
	setScreen "home"
}

// 战败（基地被毁或生命用完）：每局第一次战败时询问是否看视频复活
func defeat() {
	if gameOver {
		return
	}
	gameOver = true
	if revived {
		endGame false
		return
	}
	state = stRevive
	broadcast "reviveFlow"
}

// 开始播放激励视频，reward 是看完后的奖励
func watchAd(reward int) {
	if state == stAd {
		return
	}
	state = stAd
	adReward = reward
	broadcast "adFlow"
}

// 复活：修复基地、额外 1 条命，玩家回到出生点并获得出生保护
func revive() {
	revived = true
	if baseDown {
		baseDown = false
		grid[baseIdx] = 9
		broadcast "baseChanged"
	}
	lives++
	broadcast "hud"
	Camera.setZoom 1
	Camera.setXYpos 0, 0
	state = stPlay
	setScreen ""
	Player.respawn
	gameOver = false
	toast "msg.revived", 1.5
}

func endGame(win bool) {
	gameOver = true
	won = win
	state = stResult
	coins = score / 50
	if win {
		coins += 100
	}
	doubled = false
	broadcast "gameEnd"
	showResult
}

func showResult() {
	name := "result_lose_"
	if won && stage == aiStage {
		name = "result_aiwin_" // AI 关卡：再造一关
	} else if won && stage == lastStage {
		name = "result_final_" // 全部通关
	} else if won {
		name = "result_win_"
	}
	if doubled {
		name += "done"
	} else {
		name += "plain"
	}
	setScreen name
	broadcast "hud" // 刷新金币数
}

// 结算后的“再来一局”按钮（R）：赢了进下一关；全部通关后从第 1 关重新开始；输了重打本关
func again() {
	if stage == aiStage {
		if won {
			openAIMaker // 再造一关
		} else {
			startGame // 同一张 AI 地图再来一局
		}
		return
	}
	if won && stage < lastStage {
		stage++
		stageScore = score
	} else if won {
		stage = 1
		stageScore = 0
	}
	startGame
}

// 从主页进入第 n 关（得分从 0 开始）
func playStage(n int) {
	stage = n
	stageScore = 0
	startGame
}

// 确认键：主页开始、复活询问时看视频、结算时看视频翻倍
func confirm() {
	switch state {
	case stHome:
		playStage 1
	case stAIMaker:
		broadcast "aiInputFlow"
	case stRevive:
		watchAd rewardRevive
	case stResult:
		if !doubled {
			watchAd rewardDouble
		}
	}
}

// ---------- 路演演示模式 ----------

// 敌人汇报自己的位置，自动驾驶只记住离玩家最近的那辆
func seeEnemy(x, y float64) {
	d := math.Abs(x-Player.xpos) + math.Abs(y-Player.ypos)
	if tgtAge > 0.3 || d < tgtDist {
		tgtX = x
		tgtY = y
		tgtDist = d
		tgtAge = 0
	}
}

// 自动驾驶选方向：先和最近的敌人对齐到同一行或同一列，然后朝它开（一直在开火，砖墙会被打穿）。
// 撞墙后随机绕一会儿路
func autopilotDir(dt float64) int {
	tgtAge += dt
	tgtDist += 60 * dt // 让旧目标慢慢“变远”，更近的敌人能接替
	if apTimer > 0 {
		apTimer -= dt
		return apDir
	}
	if tgtAge > 0.5 {
		return 0 // 暂时没有敌人：往上走
	}
	dx := tgtX - Player.xpos
	dy := tgtY - Player.ypos
	if math.Abs(dx) < 8 {
		if dy > 0 {
			return 0
		}
		return 180
	}
	if math.Abs(dy) < 8 || math.Abs(dx) < math.Abs(dy) {
		if dx > 0 {
			return 90
		}
		return -90
	}
	if dy > 0 {
		return 0
	}
	return 180
}

// 自动驾驶撞墙了：随机选个方向绕一会儿路
func autopilotBlocked() {
	if apTimer > 0 {
		return
	}
	n := rand(1, 4)
	if n == 1 {
		apDir = 0
	} else if n == 2 {
		apDir = 90
	} else if n == 3 {
		apDir = -90
	} else {
		apDir = 180
	}
	apTimer = rand(0.4, 0.9)
}

// 等到画面进入状态 st（最多等 secs 秒），用于演示脚本按实际状态推进
func waitState(st int, secs float64) {
	for secs > 0 && state != st {
		wait 0.2
		secs -= 0.2
	}
}

func baseDestroyed() {
	if gameOver {
		return
	}
	baseDown = true
	broadcast "baseChanged"
	sfx "basefall"
	if theme == 1 {
		broadcast "baseCam"
	}
	Boom.explodeAt baseX, baseY, 1.5
	defeat
}

func enemyKilled(points int) {
	score += points
	killed++
	enemiesAlive--
	enemiesLeft = totalEnemy - killed
	if score > best {
		best = score
	}
	broadcast "hud"
	if killed >= totalEnemy {
		endGame true
	}
}

// 轮流在左上、中上、右上三个出生点放出敌人，坦克类型按本关配置随机
func spawnEnemy() {
	heavy, fast, _, _ := stageTune()
	c := (spawned % 3) * 6
	kind := 0 // 0 普通坦克，1 快速坦克，2 重型坦克
	n := rand(1, 100)
	if n <= heavy {
		kind = 2
	} else if n <= heavy+fast {
		kind = 1
	}
	Enemy.spawn cellX(c), cellY(0), kind
	spawned++
	enemiesAlive++
}

// 根据 levelMap 生成砖墙、钢墙和基地（都是 Tile 的克隆）
func buildMap() {
	grid = make([]int, rows*cols)
	for r := 0; r < rows; r++ {
		line := levelMap()[r]
		for c := 0; c < cols; c++ {
			i := r*cols + c
			switch line[c] {
			case 'B':
				grid[i] = 1
				Tile.build cellX(c), cellY(r), 1, i
			case 'S':
				grid[i] = 2
				Tile.build cellX(c), cellY(r), 2, i
			case 'W':
				grid[i] = 4
				Tile.build cellX(c), cellY(r), 4, i
			case 'G':
				grid[i] = 5
				Tile.build cellX(c), cellY(r), 5, i
			case 'E':
				grid[i] = 9
				baseX = cellX(c)
				baseY = cellY(r)
				baseIdx = i
				Tile.build baseX, baseY, 9, i
			}
		}
	}
}

// v2 默认使用现代画风（按 T 可以切到 1985 经典像素风）
func initTheme() {
	theme = 1
	setBackdrop look("field")
}

func startGame() {
	gameOver = true // 先暂停，等地图搭好再开始
	broadcastAndWait "clear"
	stopAllSounds
	score = stageScore
	lives = 3
	spawned = 0
	enemiesAlive = 0
	killed = 0
	pbCount = 0
	enemiesLeft = totalEnemy
	baseDown = false
	revived = false
	state = stPlay
	setScreen ""
	Camera.setZoom 1
	Camera.setXYpos 0, 0
	buildMap
	broadcast "hud"
	Player.respawn
	sfx "start"
	toast stageTip(), 3
	gameOver = false
}

// 在输入框里打字时不响应快捷键
onKey KeyT, => {
	if state != stAIInput {
		switchTheme
	}
}

onKey KeyL, => {
	if state != stAIInput {
		switchLang
	}
}

// 震屏：镜头快速抖动几下再回到中心
onMsg "shake", => {
	p := shakePower
	repeat 6, => {
		Camera.setXYpos rand(-p, p), rand(-p, p)
		wait 0.03
	}
	if !camBusy {
		Camera.setXYpos 0, 0
	}
}

// 现代画风下基地被摧毁：镜头推近特写
onMsg "baseCam", => {
	camBusy = true
	Camera.setXYpos baseX, baseY
	Camera.setZoom 1.8
	wait 2
	Camera.setZoom 1
	Camera.setXYpos 0, 0
	camBusy = false
}

onKey KeyEnter, => {
	confirm
}

onKey KeyJ, => {
	confirm
}

onKey KeySpace, => {
	if state == stHome {
		playStage 1
	}
}

// 主页按 1~8 直接进入对应关卡
onKey [Key1, Key2, Key3, Key4, Key5, Key6, Key7, Key8], (key) => {
	n := int(key) - int(Key0)
	if state == stHome {
		playStage n
	} else if state == stAIMaker && n <= 6 {
		startAI n, "" // AI 造关页面：选主题
	}
}

// 主页按 A 进入 AI 造关
onKey KeyA, => {
	if state == stHome {
		openAIMaker
	}
}

onKey KeyEscape, => {
	if state == stRevive {
		endGame false
	} else if state == stAIMaker {
		goHome
	}
}

onKey KeyR, => {
	if state == stResult {
		again
	}
}

onKey KeyP, => {
	if state == stHome {
		broadcast "demoFlow"
	}
}

onKey KeyH, => {
	if state == stResult {
		goHome
	}
}

// AI 造关：在底部的输入框里输入一句话（ask 会一直等到玩家按 Enter）
onMsg "aiInputFlow", => {
	if state != stAIMaker {
		return
	}
	state = stAIInput
	setScreen "aiinput"
	ask "" // 提示文字画在页面上，引擎的输入框只负责输入
	p := strings.TrimSpace(answer)
	if p == "" {
		openAIMaker
		return
	}
	startAI themeOf(p), p
}

// AI 造关：设计地图。XBuilder 版里 AIMaker 精灵收到 "aiDesign" 后会请求大模型（设置 aiBusy，完成后填好 aiRows）；
// 没有 AIMaker（本地运行、导出的 App）或者大模型失败时，用本地程序化生成
onMsg "aiFlow", => {
	aiRows = nil
	aiBusy = false
	aiByModel = false
	broadcast "aiDesign"
	n := 1
	t := 0.0
	for {
		setScreen "aithink_" + strconv.Itoa(n)
		n = n%3 + 1
		wait 0.3
		t += 0.3
		if aiBusy {
			if aiRows != nil || t > 25 {
				break
			}
		} else if t >= 1.5 {
			break
		}
	}
	if aiRows == nil || mapProblem(aiRows) != "" {
		aiRows = genMap(aiTheme)
		aiByModel = false
	}
	playStage aiStage
}

// 复活询问：倒计时结束还没选择就直接结算
onMsg "reviveFlow", => {
	wait 2.2 // 先让爆炸和镜头特写播完
	for n := reviveSeconds; n >= 1; n-- {
		if state != stRevive {
			return
		}
		setScreen "revive_" + strconv.Itoa(n)
		wait 1
	}
	if state == stRevive {
		endGame false
	}
}

// 模拟的激励视频：倒计时结束后发放奖励（正式版接入 Google H5 Games Ads）
onMsg "adFlow", => {
	for n := adSeconds; n >= 1; n-- {
		setScreen "adplay_" + strconv.Itoa(n)
		wait 1
	}
	if adReward == rewardRevive {
		revive
	} else {
		coins *= 2
		doubled = true
		state = stResult
		showResult
	}
}

// 路演演示：对局（自动驾驶）→ 切画风 → 切语言 → 防线失守 → 看视频复活 → 胜利 → 看视频翻倍 → 回主页。
// 每一步都按实际状态推进：如果对局中真的战败了，也会自然进入复活流程
onMsg "demoFlow", => {
	playStage 1
	autopilot = true
	apTimer = 0
	tgtAge = 9
	wait 9
	switchTheme // 经典画风（情怀）
	wait 4
	switchTheme // 回到现代画风
	wait 2
	switchLang // English
	wait 5
	switchLang // 中文
	wait 3
	if state == stPlay {
		baseDestroyed // 演示脚本安排的“防线失守”
	}
	waitState stRevive, 10
	wait 3
	if state == stRevive {
		watchAd rewardRevive
	}
	waitState stPlay, 10
	wait 7
	if state == stPlay {
		endGame true
	}
	waitState stResult, 5
	wait 3
	if state == stResult && !doubled {
		watchAd rewardDouble
	}
	waitState stResult, 10
	wait 4
	autopilot = false
	broadcast "demoDone"
}

onMsg "demoDone", => {
	goHome
}

// 游戏结束后，等爆炸声播完再放胜利 / 失败音乐
onMsg "gameEnd", => {
	wait 1.2
	if state != stResult {
		return // 已经重新开始或回到主页了
	}
	if won {
		sfx "win"
	} else {
		sfx "gameover"
	}
}

onStart => {
	stage = 1
	initTheme
	buildHud
	goHome
	for {
		_, _, gap, maxAlive := stageTune()
		wait gap
		if !gameOver && spawned < totalEnemy && enemiesAlive < maxAlive {
			spawnEnemy
		}
	}
}
