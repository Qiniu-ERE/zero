import (
	"math"
	"os"
	"strconv"
	"strings"
)

var (
	grid         []int // 地图格子：0 空地，1 砖墙，2 钢墙，3 裂开的砖墙，4 水面，5 草丛，9 基地
	score        int   // 得分
	best         int   // 本次运行的最高分
	lives        int   // 玩家剩余生命
	enemiesLeft  int   // 还需要消灭的敌人数量
	spawned      int   // 已经出场的敌人数量
	enemiesAlive int   // 场上活着的敌人数量
	killed       int   // 已消灭的敌人数量
	pbCount      int   // 场上玩家子弹数量（经典玩法：同时只能有 1 发）
	gameOver     bool  // 游戏是否结束
	won          bool  // 是否胜利
	theme        int   // 画风：0 经典像素，1 现代 3D 风格（按 T 切换）
	lang         int   // 语言：0 中文，1 English（按 L 或点右上角切换）
	toastKey     string  // 提示条要显示的文案 key
	toastSecs    float64 // 提示条显示多久
	baseDown     bool  // 基地是否已被摧毁
	camBusy      bool  // 镜头特写进行中（此时不震屏）
	shakePower   float64
	baseX        float64 // 基地位置（基地是 Tile 的一个克隆）
	baseY        float64
	baseIdx      int     // 基地所在的格子编号（复活时修复基地用）
	stage        int     // 当前关卡：1…lastStage
	stageScore   int     // 进入本关时的得分（重打本关时从这里开始）

	// 双人合作（见 docs/v3/COOP.md）：2P 是 Player 的克隆
	coop      bool    // 是否双人模式
	p2Exists  bool    // 2P 克隆是否存在
	lives2    int     // 2P 剩余生命
	pbCount2  int     // 场上 2P 的子弹数量（同时只能有 1 发）
	p1x       float64 // 两辆坦克的位置（死了就是很远的地方），敌人子弹靠它判断打中了谁
	p1y       float64
	p2x       float64
	p2y       float64
	hitWho    int // 刚被打中的是 1P 还是 2P（"playerHit" 消息的参数）
	ebPos     map[*EBullet][2]float64 // 场上每颗敌人子弹的位置（每帧更新），玩家子弹用它判断迎面相撞
	ebHit     map[*EBullet]bool       // 被玩家子弹撞上的敌人子弹，它下一帧自己消失
	resultReady bool // 结算弹窗出现 0.6 秒后才接受确认键（防止连按开火键误点“看视频”）

	// 自己做地图（见 docs/v3/MAP_EDITOR.md）
	ed        []byte // 正在编辑的地图，169 个字符：. B S W G E
	edTool    int    // 当前工具：1 砖墙 2 钢墙 3 水面 4 草丛 5 橡皮擦
	edMirror  bool   // 对称绘制
	edProblem int    // 检查结果：0 可以玩，1 敌人到不了基地，2 坦克开不到敌人出生点
	edMark    int    // 出问题的格子（-1 表示没有）
	edCursor  int    // 鼠标所在的格子（-1 表示不在战场上）
	edChanged int    // 刚改过的格子（"tileGone" 消息的参数）
	edCopy    int    // 上次复制的关卡
	edLoaded  bool   // 是否已经尝试过读取保存的地图

	// 流程与广告（见 docs/ARCHITECTURE.md 的「游戏流程」）
	state        int    // 当前画面：stHome / stPlay / stRevive / stAd / stResult
	screen       string // 全屏 / 弹窗画面的造型名（不含语言后缀），"" 表示不显示
	revived      bool   // 本局是否已经复活过（每局只能复活一次）
	coins        int    // 本局获得的金币
	doubled      bool   // 金币是否已经通过看视频翻倍
	adReward     int    // 正在播放的激励视频对应的奖励：rewardRevive / rewardDouble
	cardClosed   bool   // 玩家关掉了对局中的原生广告卡
	bannerClosed bool   // 玩家关掉了主页横幅

	// 路演演示模式（主页按 P）：玩家坦克自动驾驶，脚本依次展示各项功能
	autopilot bool
	apDir     int     // 自动驾驶绕路时的方向
	apTimer   float64 // 还要绕路多久（撞墙后随机走一会儿）
	tgtX      float64 // 最近一辆敌人的位置（敌人每帧通过 seeEnemy 汇报）
	tgtY      float64
	tgtDist   float64
	tgtAge    float64 // 距离上次汇报过了多久，太久说明目标已经没了
)

const (
	stHome   = 0 // 主页
	stPlay   = 1 // 对局中
	stRevive = 2 // 询问是否看视频复活
	stAd     = 3 // 正在播放（模拟的）激励视频
	stResult = 4 // 结算
	stEdit   = 5 // 自己做地图
	stPause  = 6 // 对局暂停（Esc 或顶栏的暂停按钮）

	rewardRevive = 1 // 激励视频奖励：复活
	rewardDouble = 2 // 激励视频奖励：金币翻倍

	adSeconds     = 5 // 模拟激励视频的时长
	reviveSeconds = 7 // 复活询问的倒计时
)

const (
	cols       = 13     // 地图列数
	rows       = 13     // 地图行数
	fieldLeft  = -228.0 // 战场左边界
	fieldTop   = 150.0  // 战场上边界
	totalEnemy = 20     // 每关敌人总数
	lastStage  = 8      // 关卡总数
	touchUI    = false  // 触屏模式：打 Android / iOS 包时 tools/export/build.sh 会把它改成 true
	padX       = 162.0  // 触屏模式的方向键中心（右侧面板里）
	padY       = 8.0
	padR       = 58.0 // 方向键的响应半径
	customStage = 9     // 自制地图试玩时的关卡编号
)

// 关卡地图（13 x 13，每格 24 像素）
// . 空地   B 砖墙（可打碎）   S 钢墙（打不碎）   W 水面（坦克过不去，子弹能飞过）   G 草丛（能藏身）   E 基地（老鹰）
// 规则：第 0 行的第 0、6、12 列是敌人出生点，第 12 行第 4 列是玩家出生点，都必须是空地；基地固定在第 12 行第 6 列。
// 改完地图运行 python3 tools/levels/check.py 检查（出生点、连通性等）
func levelMap() []string {
	if stage == customStage {
		return edRows()
	}
	switch stage {
	case 2: // 水乡迷宫：大片水面分割战场，坦克要绕路，子弹却能隔河对射
		return []string{
			".............",
			".B.B.....B.B.",
			".B.B.WWW.B.B.",
			"......B......",
			"WWW.BBBBB.WWW",
			".............",
			".BB.WW.WW.BB.",
			".BB.......BB.",
			"WW..B.S.B..WW",
			"....B...B....",
			".WW.......WW.",
			".....BBB.....",
			".....BEB.....",
		}
	case 3: // 丛林伏击：草丛遍地，快速坦克从草里冲出来
		return []string{
			".............",
			".GGG.B.B.GGG.",
			".GBG.B.B.GBG.",
			".GGG.....GGG.",
			"...GGG.GGG...",
			"BB.G.BSB.G.BB",
			"...G.....G...",
			".GGGGB.BGGGG.",
			".G.........G.",
			".G.BB.G.BB.G.",
			"GG.B.GGG.B.GG",
			"G....BBB....G",
			"G....BEB....G",
		}
	case 4: // 钢铁堡垒：钢墙林立，重型坦克为主
		return []string{
			".............",
			".S.S.SSS.S.S.",
			".S.S.....S.S.",
			"...B.S.S.B...",
			"SS.B.....B.SS",
			"...BSS.SSB...",
			".B.........B.",
			".B.SSB.BSS.B.",
			".B.........B.",
			"SSB.B.S.B.BSS",
			"...B.....B...",
			"..S..BBB..S..",
			"..S..BEB..S..",
		}
	case 5: // 砖城巷战：密集的砖墙街区，要自己打出一条路
		return []string{
			".............",
			".BBB.BBB.BBB.",
			".B.B.B.B.B.B.",
			".BBB.B.B.BBB.",
			".............",
			"BB.BBB.BBB.BB",
			"...B.....B...",
			".B.B.BBB.B.B.",
			".B...B.B...B.",
			".BBB.B.B.BBB.",
			".............",
			".BB..BBB..BB.",
			".B...BEB...B.",
		}
	case 6: // 闪电突袭：开阔地，敌军出动更快、快速坦克更多
		return []string{
			".............",
			".............",
			"..S.......S..",
			"....B...B....",
			".............",
			"GG..S.B.S..GG",
			".............",
			"WW..S.B.S..WW",
			".............",
			"....B...B....",
			"..S.......S..",
			".....BBB.....",
			".....BEB.....",
		}
	case 7: // 双子要塞：左右两座砖堡，中间一道水渠，小心交叉火力
		return []string{
			".............",
			".SBBS...SBBS.",
			".B..B...B..B.",
			".B..B.G.B..B.",
			".SB.S...S.BS.",
			"......W......",
			"GG.B..W..B.GG",
			"......W......",
			".BB.S...S.BB.",
			"..B.......B..",
			"B...B.S.B...B",
			".....BBB.....",
			".....BEB.....",
		}
	case 8: // 最终决战：各种地形都有，出兵最密集
		return []string{
			".............",
			".B.S.B.B.S.B.",
			".B.S.B.B.S.B.",
			".B...GGG...B.",
			"...WW...WW...",
			"SB.WW.S.WW.BS",
			"...GG...GG...",
			".BB..BBB..BB.",
			".B..B...B..B.",
			"GG..B.S.B..GG",
			"...SB...BS...",
			"...S.BBB.S...",
			"...S.BEB.S...",
		}
	}
	// 第 1 关：钢铁峡谷
	return []string{
		".............",
		".B.B.B.B.B.B.",
		".B.B.B.B.B.B.",
		".B.B.BSB.B.B.",
		".B.B.....B.B.",
		"GG...B.B...GG",
		"SS.BB...BB.SS",
		"WW...B.B...WW",
		".B.B.BBB.B.B.",
		".B.B.B.B.B.B.",
		".B.B.....B.B.",
		".B.B.BBB.B.B.",
		".....BEB.....",
	}
}

// 本关的敌军配置：重型坦克占比（%）、快速坦克占比（%）、出兵间隔（秒）、场上最多几辆
func stageTune() (int, int, float64, int) {
	switch stage {
	case 2:
		return 20, 30, 2.0, 4
	case 3:
		return 10, 60, 1.8, 4
	case 4:
		return 50, 10, 2.2, 4
	case 5:
		return 30, 30, 1.8, 4
	case 6:
		return 10, 70, 1.2, 5
	case 7:
		return 30, 50, 1.5, 5
	case 8:
		return 45, 45, 1.3, 5
	}
	return 20, 30, 2.0, 4
}

// 每关开始时的提示（文案 key 见 tools/assets/strings.py）
func stageTip() string {
	if stage == customStage {
		return "msg.ed.play"
	}
	if stage == 1 {
		return "msg.start"
	}
	return "msg.stage" + strconv.Itoa(stage)
}

// 玩家子弹的朝向：2P 的子弹存的是朝向 + 1000（见 PBullet.fire）
func bulletDir(f int) int {
	if f >= 500 {
		return f - 1000
	}
	return f
}

// 子弹迎面相撞：玩家子弹这一帧从 (x0, y0) 飞到 (x1, y1)，有没有敌人子弹离这段路线不到 r。
// 不用 touching：引擎里子弹的碰撞区域几乎只是一个点（相距 2 像素就不算碰到），迎面飞来的两颗子弹
// 很少正好落在同一个点上，原来 10 次只有 1~2 次能抵消（测试方案第九节，C17）。
// 撞上的敌人子弹记在 ebHit 里，由它自己在下一帧消失（不在别的协程里 destroy 它）
func bulletClash(x0, y0, x1, y1, r float64) bool {
	dx, dy := x1-x0, y1-y0
	ll := dx*dx + dy*dy
	for e, p := range ebPos {
		if ebHit[e] {
			continue
		}
		t := 0.0
		if ll > 0 {
			t = ((p[0]-x0)*dx + (p[1]-y0)*dy) / ll
			t = math.Max(0, math.Min(1, t))
		}
		cx, cy := x0+t*dx-p[0], y0+t*dy-p[1]
		if cx*cx+cy*cy <= r*r {
			if ebHit == nil {
				ebHit = map[*EBullet]bool{}
			}
			ebHit[e] = true
			return true
		}
	}
	return false
}

// (x, y) 离哪辆玩家坦克更近：1 或 2
func nearestPlayer(x, y float64) int {
	if p2Exists && math.Abs(x-p2x)+math.Abs(y-p2y) < math.Abs(x-p1x)+math.Abs(y-p1y) {
		return 2
	}
	return 1
}

// ---------- 自己做地图 ----------

// 锁定格：三个敌人出生点、1P / 2P 出生点、基地和基地上方左右的护墙，不能修改
func edLocked(i int) bool {
	switch i {
	case 0, 6, 12, 12*cols + 4, 12*cols + 8, 12*cols + 6, 11*cols + 5, 11*cols + 6, 11*cols + 7, 12*cols + 5, 12*cols + 7:
		return true
	}
	return false
}

// 锁定格的固定内容
func edLockedChar(i int) byte {
	if i == 12*cols+6 {
		return 'E'
	}
	if i == 11*cols+5 || i == 11*cols+6 || i == 11*cols+7 || i == 12*cols+5 || i == 12*cols+7 {
		return 'B'
	}
	return '.'
}

// 空白地图（只有锁定格）
func edBlank() {
	ed = make([]byte, rows*cols)
	for i := range ed {
		ed[i] = edLockedChar(i)
	}
}

func edRows() []string {
	m := []string{}
	for r := 0; r < rows; r++ {
		m = append(m, string(ed[r*cols:(r+1)*cols]))
	}
	return m
}

// 用 13 行地图覆盖正在编辑的地图（锁定格保持不变）；格式不对返回 false
func edLoadRows(m []string) bool {
	if len(m) < rows {
		return false
	}
	for r := 0; r < rows; r++ {
		if len(m[r]) != cols {
			return false
		}
		for c := 0; c < cols; c++ {
			if !strings.ContainsRune(".BSWG", rune(m[r][c])) && !(r == 12 && c == 6) {
				return false
			}
		}
	}
	for r := 0; r < rows; r++ {
		for c := 0; c < cols; c++ {
			i := r*cols + c
			if edLocked(i) {
				ed[i] = edLockedChar(i)
			} else {
				ed[i] = m[r][c]
			}
		}
	}
	return true
}

// 地图字符对应的 grid 编号
func edCode(ch byte) int {
	switch ch {
	case 'B':
		return 1
	case 'S':
		return 2
	case 'W':
		return 4
	case 'G':
		return 5
	case 'E':
		return 9
	}
	return 0
}

func edToolChar(t int) byte {
	return []byte(".BSWG.")[t]
}

func tankCanPass(ch byte) bool {
	return ch == '.' || ch == 'G' || ch == 'B' || ch == 'E' // 砖墙能打掉，算作能通过
}

// 从格子 start 出发，坦克能到达哪些格子（m 是 169 个字符）
func reachable(m []byte, start int) []bool {
	seen := make([]bool, rows*cols)
	seen[start] = true
	queue := []int{start}
	for len(queue) > 0 {
		i := queue[0]
		queue = queue[1:]
		c := i % cols
		for _, n := range []int{i - cols, i + cols, i - 1, i + 1} {
			if n < 0 || n >= rows*cols || seen[n] || !tankCanPass(m[n]) {
				continue
			}
			if (n == i-1 && c == 0) || (n == i+1 && c == cols-1) {
				continue // 不能从一行的末尾绕到下一行
			}
			seen[n] = true
			queue = append(queue, n)
		}
	}
	return seen
}

// 检查地图（规则和 tools/levels/check.py 相同；锁定格保证了出生点和基地的位置）
func edCheck() {
	edProblem = 0
	edMark = -1
	for _, s := range []int{0, 6, 12} {
		got := reachable(ed, s)
		if !got[11*cols+6] && !got[12*cols+5] && !got[12*cols+7] {
			edProblem = 1
			edMark = s
			return
		}
	}
	for _, p := range []int{12*cols + 4, 12*cols + 8} {
		got := reachable(ed, p)
		for _, s := range []int{0, 6, 12} {
			if !got[s] {
				edProblem = 2
				edMark = p
				return
			}
		}
	}
}

// 按 ed 重新摆好所有格子
func edRebuild() {
	broadcastAndWait "clear"
	grid = make([]int, rows*cols)
	for i := 0; i < rows*cols; i++ {
		grid[i] = edCode(ed[i])
		if grid[i] != 0 {
			Tile.build cellX(i%cols), cellY(i/cols), grid[i], i
		}
	}
	edCheck()
}

// 把格子 i 改成 ch，返回有没有变化
func edPaint(i int, ch byte) bool {
	if i < 0 || edLocked(i) || ed[i] == ch {
		return false
	}
	ed[i] = ch
	grid[i] = edCode(ch)
	edChanged = i
	broadcastAndWait "tileGone" // 旧格子的克隆先消失
	if grid[i] != 0 {
		Tile.build cellX(i%cols), cellY(i/cols), grid[i], i
	}
	return true
}

// 进入地图编辑器
func openEditor() {
	state = stEdit
	autopilot = false
	gameOver = true
	broadcastAndWait "clear"
	if p2Exists {
		broadcastAndWait "p2off"
	}
	Player.hide // 编辑器的战场是透明的，玩家坦克要藏起来
	stopAllSounds
	Camera.setZoom 1
	Camera.setXYpos 0, 0
	stage = customStage
	if ed == nil {
		edBlank()
		edTool = 1
		edMirror = true
		edCursor = -1
	}
	loaded := false
	if !edLoaded {
		edLoaded = true
		loaded = edLoad()
	}
	edRebuild()
	setScreen "editor"
	broadcast "edit"
	broadcast "editLoop"
	if loaded {
		toast "msg.ed.loaded", 2
	}
}

// 保存的地图放在哪里（PC 版）；网页版没有文件系统，返回 ""
func edFile() string {
	dir, err := os.UserConfigDir()
	if err != nil || dir == "" {
		return ""
	}
	return dir + "/TankBattle/maps.txt"
}

func edSave() {
	f := edFile()
	ok := f != ""
	if ok {
		os.MkdirAll(f[:len(f)-len("/maps.txt")], 0755)
		ok = os.WriteFile(f, []byte(strings.Join(edRows(), "\n")+"\n"), 0644) == nil
	}
	if ok {
		toast "msg.ed.saved", 2
	} else {
		toast "msg.ed.savefail", 2.5
	}
}

// 读取上次保存的地图，成功返回 true
func edLoad() bool {
	f := edFile()
	if f == "" {
		return false
	}
	b, err := os.ReadFile(f)
	if err != nil {
		return false
	}
	return edLoadRows(strings.Split(strings.TrimSpace(string(b)), "\n"))
}

// 随机起点：随机生成左右对称的地图，检查合格为止
func edRandom() {
	wb := []int{40, 45, 30, 90, 55}
	ws := []int{10, 50, 5, 10, 30}
	ww := []int{45, 0, 0, 0, 5}
	dOdd := []int{45, 50, 55, 70, 25}
	dEven := []int{25, 20, 35, 30, 5}
	for try := 0; try < 80; try++ {
		t := int(rand(0, 4)) // 河流、钢铁、草丛、砖城、开阔五种风格
		edBlank()
		for r := 1; r <= 12; r++ {
			for c := 0; c <= 6; c++ {
				d := dEven[t]
				if c%2 == 1 {
					d = dOdd[t]
				}
				ch := byte('.')
				if int(rand(1, 100)) <= d {
					n := int(rand(1, 100))
					if n <= wb[t] {
						ch = 'B'
					} else if n <= wb[t]+ws[t] {
						ch = 'S'
					} else if n <= wb[t]+ws[t]+ww[t] {
						ch = 'W'
					} else {
						ch = 'G'
					}
				}
				for _, cc := range []int{c, cols - 1 - c} {
					if !edLocked(r*cols + cc) {
						ed[r*cols+cc] = ch
					}
				}
			}
		}
		edCheck()
		if edProblem == 0 {
			return
		}
	}
	edBlank()
}

// 试玩自制地图，two 表示双人
func playCustom(two bool) {
	edCheck()
	if edProblem != 0 {
		toast "msg.ed.bad", 2
		broadcast "edit"
		return
	}
	coop = two
	stage = customStage
	stageScore = 0
	startGame
}

// 编辑器里的按钮和按键
func edCommand(cmd string) {
	if state != stEdit {
		return
	}
	switch cmd {
	case "mirror":
		edMirror = !edMirror
	case "play":
		playCustom false
		return
	case "play2":
		playCustom true
		return
	case "rand":
		edRandom()
		edRebuild()
		toast "msg.ed.rand", 1.5
	case "copy":
		edCopy = edCopy%lastStage + 1
		keep := stage
		stage = edCopy
		m := levelMap()
		stage = keep
		edLoadRows m
		edRebuild()
		toast "msg.ed.copy"+strconv.Itoa(edCopy), 1.5
	case "clear":
		edBlank()
		edRebuild()
		toast "msg.ed.clear", 1.2
	case "save":
		edSave()
	case "back":
		goHome
		return
	}
	broadcast "edit"
}

// 第 c 列格子中心的 x 坐标
func cellX(c int) float64 {
	return fieldLeft + 12 + float64(c*24)
}

// 第 r 行格子中心的 y 坐标
func cellY(r int) float64 {
	return fieldTop - 12 - float64(r*24)
}

// 点 (x, y) 所在格子的编号，出界返回 -1
func cellIndex(x, y float64) int {
	c := int(math.Floor((x - fieldLeft) / 24))
	r := int(math.Floor((fieldTop - y) / 24))
	if c < 0 || c >= cols || r < 0 || r >= rows {
		return -1
	}
	return r*cols + c
}

// 点 (x, y) 处是什么：0 空地，1 砖墙，2 钢墙，3 裂开的砖墙，9 基地，-1 出界
func cellAt(x, y float64) int {
	i := cellIndex(x, y)
	if i < 0 {
		return -1
	}
	return grid[i]
}

// 坦克（边长约 22 像素）中心在 (x, y) 时，是否会压到墙、基地或出界
func tankBlocked(x, y float64) bool {
	h := 11.0
	return blocksTank(cellAt(x-h, y-h)) || blocksTank(cellAt(x+h, y-h)) || blocksTank(cellAt(x-h, y+h)) || blocksTank(cellAt(x+h, y+h))
}

// 格子 v 能不能挡住坦克：空地和草丛能开过去，其他（包括水面和出界）都不行
func blocksTank(v int) bool {
	return v != 0 && v != 5
}

// 转弯时把坐标对齐到半格（12 像素），这样坦克才能顺利钻进 1 格宽的路
func snapX(x float64) float64 {
	return fieldLeft + math.Round((x-fieldLeft)/12)*12
}

func snapY(y float64) float64 {
	return fieldTop - math.Round((fieldTop-y)/12)*12
}

// 朝向 d（0 上，90 右，180 下，-90 左）对应的 x 方向
func dirDX(d int) float64 {
	if d == 90 {
		return 1
	}
	if d == -90 {
		return -1
	}
	return 0
}

// 朝向 d 对应的 y 方向
func dirDY(d int) float64 {
	if d == 0 {
		return 1
	}
	if d == 180 {
		return -1
	}
	return 0
}

// 根据当前画风取造型 / 音效的名字：经典用 "basic"，现代用 "basic_m"
func look(name string) string {
	if theme == 1 {
		return name + "_m"
	}
	return name
}

// 播放音效。统一由舞台来播放，这样子弹消失了声音也不会被打断
func sfx(name string) {
	play look(name)
}

// 循环播放（用于引擎声）
func sfxLoop(name string) {
	play look(name), true
}

// 当前语言代码，HUD 造型名用它做后缀："score_zh"、"score_en"
func langCode() string {
	if lang == 1 {
		return "en"
	}
	return "zh"
}

func switchLang() {
	lang = 1 - lang
	broadcast "langChanged"
	toast "msg.lang", 1.2
}

// 显示提示条（文案 key 见 tools/assets/strings.py 的 msg.*）
func toast(k string, secs float64) {
	toastKey = k
	toastSecs = secs
	broadcast "toast"
}

// 搭建 HUD。坐标都是舞台坐标（中心为原点，y 向上），和 tools/assets/build.py 的布局一致
func buildHud() {
	// 顶栏：关卡名、敌军剩余、语言按钮
	UI.label -228, 160, "stage" // 关卡名：造型是 "stage.<关卡号>_<语言>"，双人时带「双人」标签
	UI.label -36, 160, "enemies"
	for i := 0; i < totalEnemy; i++ {
		UI.icon kPip, -29+float64(i)*5.8, 163, i
	}
	UI.langButton 208, 164
	UI.icon kPauseBtn, 176, 164, 0 // 暂停按钮（对局中显示；手机上没有 Esc 键，靠它暂停和退出）
	// 右侧面板：得分、最高分、生命、按键提示
	UI.label 104, 140, "score"
	UI.number kScore, 104, 120, 9
	UI.label 104, 104, "best"
	UI.number kBest, 220, 104, 9
	UI.label 104, 80, "lives"
	UI.label 104, 64, "tag.1p" // 1P / 2P 标签只在双人时显示
	UI.label 104, 48, "tag.2p"
	for i := 0; i < 3; i++ {
		UI.icon kLife, 110+float64(i)*16, 68, i // 位置在刷新时按单人 / 双人调整
		UI.icon kLife2, 124+float64(i)*16, 52, i
	}
	UI.label 104, 30, "hint.move" // 双人时换成 1P / 2P 的按键说明
	UI.label 104, 14, "hint.fire"
	UI.label 104, -2, "hint.style"
	UI.label 104, -18, "hint.lang"
	// 广告位：对局中的原生广告卡、主页横幅
	UI.adSlot 162, -113, "card"
	UI.adSlot 0, -152, "banner"
	// 全屏 / 弹窗画面，以及结算弹窗里的金币数
	UI.screenLayer
	UI.icon kTouchPad, padX, padY, 0 // 触屏模式的方向键（只在触屏模式的对局中显示）
	// 编辑器的小部件（只在编辑器里显示）
	UI.icon kEdSel, 0, 0, 0
	UI.icon kEdSwitch, 208, 83, 0  // 对称开关
	UI.icon kEdSwitch, -72, -6, 1  // 对称线
	UI.icon kEdStatus, 104, 70, 0
	UI.icon kEdCursor, 0, 0, 0
	UI.icon kEdMark, 0, 0, 0
	UI.number kCoin, -132, 35, 9
	// 战场上方的提示条
	UI.toastBar -72, 20
}

func baseLook() string {
	if baseDown {
		return look("broken")
	}
	return look("eagle")
}

// 切换画风：舞台换背景，其他精灵收到 "themeChanged" 后各自换造型
func switchTheme() {
	theme = 1 - theme
	setBackdrop look("field")
	broadcast "themeChanged"
	if theme == 1 {
		toast "msg.modern", 1.2
	} else {
		toast "msg.classic", 1.2
	}
}

// 现代画风下的震屏（由爆炸触发）
func shake(power float64) {
	if theme == 1 && !camBusy {
		shakePower = power
		broadcast "shake"
	}
}

// 砖墙要打两下：第一下裂开，第二下才碎（和原版一样，基地不会太快被打穿）
// 砖墙精灵收到 "gridChanged" 后会自己对照 grid 更新（同一帧打中两块砖也不会漏掉）
func breakBrick(i int) {
	if grid[i] == 1 {
		grid[i] = 3
	} else {
		grid[i] = 0
	}
	broadcast "gridChanged"
}

// 子弹的某个检测点碰到东西了吗？碰到砖墙会把砖打碎
// byPlayer：是不是玩家的子弹（和原版一样，只有玩家的子弹打墙才有声音）
func hitPoint(x, y float64, byPlayer bool) bool {
	i := cellIndex(x, y)
	if i < 0 {
		return true
	}
	switch grid[i] {
	case 1, 3:
		breakBrick(i)
		if byPlayer {
			sfx "brick"
		}
		return true
	case 2:
		if byPlayer {
			sfx "steel"
		}
		return true
	case 9:
		if !autopilot { // 路演演示时基地不会被打掉，由演示脚本安排“防线失守”
			baseDestroyed()
		}
		return true
	}
	return false
}

// 在 (x, y) 处朝 d 方向飞行的子弹是否撞到了墙、基地或边界
// 弹头左右各有一个检测点，所以一发子弹可以同时打掉并排的两块砖
func bulletHit(x, y float64, d int, byPlayer bool) bool {
	fx := x + dirDX(d)*3
	fy := y + dirDY(d)*3
	px := dirDY(d) * 6
	py := dirDX(d) * 6
	a := hitPoint(fx+px, fy+py, byPlayer)
	// 两个检测点落在同一格时只算一次：否则正对一块砖打，一发就会扣两下（砖墙应该打两下才碎）
	i := cellIndex(fx+px, fy+py)
	if i >= 0 && i == cellIndex(fx-px, fy-py) {
		return a
	}
	b := hitPoint(fx-px, fy-py, byPlayer)
	return a || b
}

// ---------- 流程：主页 → 对局 → (复活询问 → 激励视频) → 结算 ----------

// 切换全屏 / 弹窗画面。先让画面层到最前，再把广告位、语言按钮和提示条放到它上面
func setScreen(name string) {
	screen = name
	broadcastAndWait "screen"
	broadcast "raise"
}

func goHome() {
	state = stHome
	autopilot = false
	gameOver = true
	broadcastAndWait "clear"
	if p2Exists {
		broadcastAndWait "p2off"
	}
	stopAllSounds
	Camera.setZoom 1
	Camera.setXYpos 0, 0
	setScreen "home"
}

// 战败（基地被毁或生命用完）：每局第一次战败时询问是否看视频复活
func defeat() {
	if gameOver {
		return
	}
	gameOver = true
	if revived {
		endGame false
		return
	}
	state = stRevive
	broadcast "reviveFlow"
}

// 开始播放激励视频，reward 是看完后的奖励
func watchAd(reward int) {
	if state == stAd {
		return
	}
	state = stAd
	adReward = reward
	broadcast "adFlow"
}

// 复活：修复基地、额外 1 条命，玩家回到出生点并获得出生保护
func revive() {
	revived = true
	if baseDown {
		baseDown = false
		grid[baseIdx] = 9
		broadcast "baseChanged"
	}
	lives++
	if coop {
		lives2++
	}
	broadcast "hud"
	Camera.setZoom 1
	Camera.setXYpos 0, 0
	state = stPlay
	setScreen ""
	Player.respawn
	if coop {
		broadcast "p2respawn"
	}
	gameOver = false
	toast "msg.revived", 1.5
}

func endGame(win bool) {
	gameOver = true
	won = win
	state = stResult
	coins = (score - stageScore) / 50 // 按本关得分折算（得分会带到下一关，不能重复算）
	if win {
		coins += 100
	}
	doubled = false
	resultReady = false
	broadcast "resultArm"
	broadcast "gameEnd"
	showResult
}

func showResult() {
	name := "result_lose_"
	if stage == customStage {
		name = "result_elose_" // 自制地图试玩：继续编辑
		if won {
			name = "result_ewin_"
		}
	} else if won && stage == lastStage {
		name = "result_final_" // 全部通关
	} else if won {
		name = "result_win_"
	}
	if doubled {
		name += "done"
	} else {
		name += "plain"
	}
	setScreen name
	broadcast "hud" // 刷新金币数
}

// ---------- 暂停 ----------

// 对局中暂停：战场冻结，弹出暂停菜单
func pauseGame() {
	if state != stPlay || gameOver || autopilot { // gameOver：开局或复活还没准备好
		return
	}
	state = stPause
	gameOver = true // 坦克、子弹、出兵、重生倒计时都会停下来
	if stage == customStage {
		setScreen "pause_edit"
	} else {
		setScreen "pause"
	}
}

func resumeGame() {
	if state != stPause {
		return
	}
	state = stPlay
	setScreen ""
	gameOver = false
}

// 暂停菜单里的“返回”：自制地图回到编辑器，其他回到主页
func quitFromPause() {
	if stage == customStage {
		openEditor
	} else {
		goHome
	}
}

// 结算后的“再来一局”按钮（R）：赢了进下一关；全部通关后从第 1 关重新开始；输了重打本关
func again() {
	if stage == customStage {
		openEditor // 继续编辑
		return
	}
	if won && stage < lastStage {
		stage++
		stageScore = score
	} else if won {
		stage = 1
		stageScore = 0
	}
	startGame
}

// 从主页开始新游戏：第 n 关，two 表示双人合作
func newGame(n int, two bool) {
	if two && touchUI {
		toast "msg.coop.touch", 2 // 手机 App 只认一根手指，2P 没法操作
		return
	}
	coop = two
	playStage n
}

// 从主页进入第 n 关（得分从 0 开始）
func playStage(n int) {
	stage = n
	stageScore = 0
	startGame
}

// 确认键：主页开始、复活询问时看视频、结算时看视频翻倍
func confirm() {
	switch state {
	case stHome:
		newGame 1, false
	case stEdit:
		playCustom false
	case stPause:
		resumeGame
	case stRevive:
		// 基地被毁后要等 2.2 秒才弹出复活询问；这期间还在连按开火键（J / Enter），不能当成“看视频复活”
		if strings.HasPrefix(screen, "revive_") {
			watchAd rewardRevive
		}
	case stResult:
		if !resultReady {
			return // 结算刚出现，玩家可能还在按开火键
		}
		if !doubled {
			watchAd rewardDouble
		}
	}
}

// ---------- 路演演示模式 ----------

// 敌人汇报自己的位置，自动驾驶只记住离玩家最近的那辆
func seeEnemy(x, y float64) {
	d := math.Abs(x-Player.xpos) + math.Abs(y-Player.ypos)
	if tgtAge > 0.3 || d < tgtDist {
		tgtX = x
		tgtY = y
		tgtDist = d
		tgtAge = 0
	}
}

// 自动驾驶选方向：先和最近的敌人对齐到同一行或同一列，然后朝它开（一直在开火，砖墙会被打穿）。
// 撞墙后随机绕一会儿路
func autopilotDir(dt float64) int {
	tgtAge += dt
	tgtDist += 60 * dt // 让旧目标慢慢“变远”，更近的敌人能接替
	if apTimer > 0 {
		apTimer -= dt
		return apDir
	}
	if tgtAge > 0.5 {
		return 0 // 暂时没有敌人：往上走
	}
	dx := tgtX - Player.xpos
	dy := tgtY - Player.ypos
	if math.Abs(dx) < 8 {
		if dy > 0 {
			return 0
		}
		return 180
	}
	if math.Abs(dy) < 8 || math.Abs(dx) < math.Abs(dy) {
		if dx > 0 {
			return 90
		}
		return -90
	}
	if dy > 0 {
		return 0
	}
	return 180
}

// 自动驾驶撞墙了：随机选个方向绕一会儿路
func autopilotBlocked() {
	if apTimer > 0 {
		return
	}
	n := int(rand(1, 4))
	if n == 1 {
		apDir = 0
	} else if n == 2 {
		apDir = 90
	} else if n == 3 {
		apDir = -90
	} else {
		apDir = 180
	}
	apTimer = rand(0.4, 0.9)
}

// 路演演示的 v3.0 部分：几个新关卡 → 双人合作 → 暂停菜单 → 地图编辑器里画一张“河流城堡”并试玩
func demoV3() {
	for _, n := range []int{2, 3, 4, 8} {
		autopilot = true
		newGame n, false
		apTimer = 0
		tgtAge = 9
		wait 3.5
	}
	autopilot = true
	newGame 1, true // 双人合作（演示时 1P 自动驾驶，2P 停在出生点）
	apTimer = 0
	tgtAge = 9
	wait 4
	autopilot = false
	pauseGame // 暂停菜单（Esc / 顶栏的 Ⅱ）
	wait 2.5
	resumeGame
	wait 0.5
	keepEd := ed // 演示会清空编辑器，结束后还原玩家的地图
	keepLoaded := edLoaded
	edLoaded = true // 演示时不读取玩家保存的地图
	openEditor
	edBlank()
	edMirror = true
	edTool = 1
	edRebuild()
	broadcast "edit"
	wait 1.5
	castle := []string{
		".............",
		".B.........B.",
		"...WWW.WWW...",
		"..W.......W..",
		"..W.SBBBS.W..",
		"....B...B....",
		"..W.B.S.B.W..",
		"..W.SB.BS.W..",
		"...WWW.WWW...",
		".B.........B.",
		".BB..B.B..BB.",
	}
	for r := 1; r < len(castle); r++ {
		for c := 0; c <= 6; c++ {
			ch := castle[r][c]
			if ch == '.' {
				continue
			}
			edTool = strings.IndexByte(".BSWG", ch) // 工具跟着换，右侧的选中框会动
			edPaint r*cols+c, ch
			edPaint r*cols+cols-1-c, ch // 对称绘制
			edCheck()
			broadcast "edit"
			wait 0.07
		}
	}
	wait 1.5
	autopilot = true
	playCustom false
	apTimer = 0
	tgtAge = 9
	wait 6
	ed = keepEd
	edLoaded = keepLoaded
}

// 等到画面进入状态 st（最多等 secs 秒），用于演示脚本按实际状态推进
func waitState(st int, secs float64) {
	for secs > 0 && state != st {
		wait 0.2
		secs -= 0.2
	}
}

func baseDestroyed() {
	if gameOver {
		return
	}
	baseDown = true
	broadcast "baseChanged"
	sfx "basefall"
	if theme == 1 {
		broadcast "baseCam"
	}
	Boom.explodeAt baseX, baseY, 1.5
	defeat
}

func enemyKilled(points int) {
	score += points
	killed++
	enemiesAlive--
	enemiesLeft = totalEnemy - killed
	if score > best && !autopilot { // 路演演示（自动驾驶）的分数不算最高分
		best = score
	}
	broadcast "hud"
	if killed >= totalEnemy {
		endGame true
	}
}

// 轮流在左上、中上、右上三个出生点放出敌人，坦克类型按本关配置随机
func spawnEnemy() {
	heavy, fast, _, _ := stageTune()
	c := (spawned % 3) * 6
	kind := 0 // 0 普通坦克，1 快速坦克，2 重型坦克
	n := int(rand(1, 100))
	if n <= heavy {
		kind = 2
	} else if n <= heavy+fast {
		kind = 1
	}
	Enemy.spawn cellX(c), cellY(0), kind
	spawned++
	enemiesAlive++
}

// 根据 levelMap 生成砖墙、钢墙和基地（都是 Tile 的克隆）
func buildMap() {
	grid = make([]int, rows*cols)
	for r := 0; r < rows; r++ {
		line := levelMap()[r]
		for c := 0; c < cols; c++ {
			i := r*cols + c
			switch line[c] {
			case 'B':
				grid[i] = 1
				Tile.build cellX(c), cellY(r), 1, i
			case 'S':
				grid[i] = 2
				Tile.build cellX(c), cellY(r), 2, i
			case 'W':
				grid[i] = 4
				Tile.build cellX(c), cellY(r), 4, i
			case 'G':
				grid[i] = 5
				Tile.build cellX(c), cellY(r), 5, i
			case 'E':
				grid[i] = 9
				baseX = cellX(c)
				baseY = cellY(r)
				baseIdx = i
				Tile.build baseX, baseY, 9, i
			}
		}
	}
}

// v2 默认使用现代画风（按 T 可以切到 1985 经典像素风）
func initTheme() {
	theme = 1
	setBackdrop look("field")
}

func startGame() {
	gameOver = true // 先暂停，等地图搭好再开始
	broadcastAndWait "clear"
	stopAllSounds
	score = stageScore
	lives = 3
	lives2 = 3
	pbCount2 = 0
	spawned = 0
	enemiesAlive = 0
	killed = 0
	pbCount = 0
	enemiesLeft = totalEnemy
	baseDown = false
	revived = false
	state = stPlay
	setScreen ""
	Camera.setZoom 1
	Camera.setXYpos 0, 0
	buildMap
	broadcast "hud"
	Player.respawn
	if coop {
		if p2Exists {
			broadcast "p2respawn"
		} else {
			Player.spawnP2
		}
	} else if p2Exists {
		broadcastAndWait "p2off"
	}
	sfx "start"
	if coop && stage == 1 {
		toast "msg.coop", 3
	} else {
		toast stageTip(), 3
	}
	gameOver = false
}

onKey KeyT, => {
	switchTheme
}

onKey KeyL, => {
	switchLang
}

// 震屏：镜头快速抖动几下再回到中心
onMsg "shake", => {
	p := shakePower
	repeat 6, => {
		Camera.setXYpos rand(-p, p), rand(-p, p)
		wait 0.03
	}
	if !camBusy {
		Camera.setXYpos 0, 0
	}
}

// 现代画风下基地被摧毁：镜头推近特写
onMsg "baseCam", => {
	camBusy = true
	Camera.setXYpos baseX, baseY
	Camera.setZoom 1.8
	wait 2
	Camera.setZoom 1
	Camera.setXYpos 0, 0
	camBusy = false
}

onKey KeyEnter, => {
	confirm
}

onKey KeyJ, => {
	confirm
}

onKey KeySpace, => {
	if state == stHome {
		newGame 1, false
	}
}

// 主页按 C：双人合作；编辑器里 C 是清空
onKey KeyC, => {
	if state == stHome {
		newGame 1, true
	} else if state == stEdit {
		edCommand "clear"
	}
}

// 主页按 E：自己做地图
onKey KeyE, => {
	if state == stHome {
		openEditor
	}
}

onKey KeyM, => {
	edCommand "mirror"
}

onKey KeyK, => {
	edCommand "copy"
}

onKey KeyS, => {
	edCommand "save"
}

// 主页按 1~8 直接进入对应关卡
onKey [Key1, Key2, Key3, Key4, Key5, Key6, Key7, Key8], (key) => {
	n := int(key) - int(Key0)
	if state == stHome {
		newGame n, false
	} else if state == stEdit && n <= 5 {
		edTool = n // 编辑器：选工具
		broadcast "edit"
	}
}

onKey KeyEscape, => {
	if state == stRevive {
		endGame false
	} else if state == stEdit {
		goHome
	} else if state == stPlay {
		pauseGame
	} else if state == stPause {
		resumeGame
	}
}

onKey KeyR, => {
	if state == stResult {
		again
	} else if state == stPause {
		startGame // 重新开始本关
	} else if state == stEdit {
		edCommand "rand"
	}
}

onKey KeyP, => {
	if state == stHome {
		broadcast "demoFlow"
	} else if state == stEdit {
		edCommand "play2"
	}
}

onKey KeyH, => {
	if state == stResult {
		goHome
	} else if state == stPause {
		quitFromPause
	}
}

// 编辑器：鼠标 / 触屏绘制。按住拖动可以连续画；对称绘制时右边同时画
onMsg "editLoop", => {
	// 点按钮进入编辑器时，点击在鼠标按下时就触发了；先等松开，否则会在按钮下面那格画上东西
	for mousePressed && state == stEdit {
		waitNextFrame
	}
	for state == stEdit {
		i := cellIndex(mouseX, mouseY)
		if i != edCursor {
			edCursor = i
			broadcast "edCursor"
		}
		if mousePressed && i >= 0 {
			ch := edToolChar(edTool)
			changed := edPaint(i, ch)
			if edMirror {
				j := (i/cols)*cols + (cols - 1 - i%cols)
				if edPaint(j, ch) {
					changed = true
				}
			}
			if changed {
				edCheck()
				broadcast "edit"
			}
		}
		waitNextFrame
	}
}

onMsg "resultArm", => {
	wait 0.6
	resultReady = true
}

// 复活询问：倒计时结束还没选择就直接结算
onMsg "reviveFlow", => {
	wait 2.2 // 先让爆炸和镜头特写播完
	for n := reviveSeconds; n >= 1; n-- {
		if state != stRevive {
			return
		}
		setScreen "revive_" + strconv.Itoa(n)
		wait 1
	}
	if state == stRevive {
		endGame false
	}
}

// 模拟的激励视频：倒计时结束后发放奖励（正式版接入 Google H5 Games Ads）
onMsg "adFlow", => {
	for n := adSeconds; n >= 1; n-- {
		setScreen "adplay_" + strconv.Itoa(n)
		wait 1
	}
	if adReward == rewardRevive {
		revive
	} else {
		coins *= 2
		doubled = true
		state = stResult
		showResult
	}
}

// 路演演示：对局（自动驾驶）→ 切画风 → 切语言 → 防线失守 → 看视频复活 → 胜利 → 看视频翻倍
// → v3.0：新关卡、双人合作、自己做地图（demoV3）→ 回主页。
// 每一步都按实际状态推进：如果对局中真的战败了，也会自然进入复活流程
onMsg "demoFlow", => {
	autopilot = true // 先设好，开局时顶栏就不会显示暂停按钮
	newGame 1, false
	autopilot = true
	apTimer = 0
	tgtAge = 9
	wait 9
	switchTheme // 经典画风（情怀）
	wait 4
	switchTheme // 回到现代画风
	wait 2
	switchLang // English
	wait 5
	switchLang // 中文
	wait 3
	if state == stPlay {
		baseDestroyed // 演示脚本安排的“防线失守”
	}
	waitState stRevive, 10
	wait 3
	if state == stRevive {
		watchAd rewardRevive
	}
	waitState stPlay, 10
	wait 7
	if state == stPlay {
		endGame true
	}
	waitState stResult, 5
	wait 3
	if state == stResult && !doubled {
		watchAd rewardDouble
	}
	waitState stResult, 10
	wait 4
	demoV3
	autopilot = false
	broadcast "demoDone"
}

onMsg "demoDone", => {
	goHome
}

// 游戏结束后，等爆炸声播完再放胜利 / 失败音乐
onMsg "gameEnd", => {
	wait 1.2
	if state != stResult {
		return // 已经重新开始或回到主页了
	}
	if won {
		sfx "win"
	} else {
		sfx "gameover"
	}
}

onStart => {
	stage = 1
	initTheme
	buildHud
	goHome
	for {
		_, _, gap, maxAlive := stageTune()
		if coop { // 双人火力翻倍，敌人来得更快、场上更多
			gap *= 0.85
			maxAlive++
		}
		wait gap
		if !gameOver && spawned < totalEnemy && enemiesAlive < maxAlive {
			spawnEnemy
		}
	}
}
