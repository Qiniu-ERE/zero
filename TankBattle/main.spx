	UI.label 104, 104, "best"
	UI.number kBest, 220, 104, 9
	UI.label 104, 80, "lives"
	UI.label 104, 64, "tag.1p" // 1P / 2P 标签只在双人时显示
	UI.label 104, 48, "tag.2p"
	for i := 0; i < 3; i++ {
		UI.icon kLife, 110+float64(i)*16, 68, i // 位置在刷新时按单人 / 双人调整
		UI.icon kLife2, 124+float64(i)*16, 52, i
	}
	// 芯片格（v6）：1P 一行、双人时 2P 再一行；触屏模式不显示（方向键在这里）
	UI.label 104, 36, "chips"
	UI.label 104, 20, "tag.c1"
	UI.label 104, 4, "tag.c2"
	for i := 0; i < 6; i++ {
		UI.icon kChip, 0, 0, i // 位置在刷新时按单人 / 双人调整
	}
	UI.label 104, -10, "hint.move" // 双人时换成 1P / 2P 的按键说明
	UI.label 104, -26, "hint.fire"
	UI.label 104, -42, "hint.style"
	UI.label 104, -58, "hint.lang"
	// 广告位：对局中的原生广告卡、主页横幅
	UI.adSlot 162, -113, "card"
	UI.adSlot 0, -152, "banner"
	// 全屏 / 弹窗画面，以及结算弹窗里的金币数
	UI.screenLayer
	UI.icon kTouchPad, padX, padY, 0 // 触屏模式的方向键（只在触屏模式的对局中显示）
	// 编辑器的小部件（只在编辑器里显示）
	UI.icon kEdSel, 0, 0, 0
	UI.icon kEdSwitch, 208, 83, 0  // 对称开关
	UI.icon kEdSwitch, -72, -6, 1  // 对称线
	UI.icon kEdStatus, 104, 70, 0
	UI.icon kEdCursor, 0, 0, 0
	UI.icon kEdMark, 0, 0, 0
	UI.number kCoin, -132, 35, 9
	UI.icon kDailyTag, -72, 116, 0 // 每日挑战结算：正式成绩 / 练习
	// 三选一（v6）：三张卡片、刷新按钮、谁在选
	for i := 0; i < 3; i++ {
		UI.icon kPick, -134+float64(i)*134, 13, i
	}
	UI.icon kPick, 0, -98, 3
	UI.icon kPick, 0, 150, 4
	// 战场上方的提示条
