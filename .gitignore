.build/
dist/
__pycache__/

# 签名证书、描述文件和密钥不进仓库（Android 调试证书默认在 ~/.config/tankbattle/，见 tools/export/build.sh）
*.keystore
*.jks
*.p12
*.mobileprovision
.env
.venv/
.claude/

# spx run 生成的引擎缓存（gdextension、lib、.godot），每次运行会重新生成
.temp/

# 路演幻灯片（Keynote / PowerPoint / PDF）在仓库外维护，不进仓库
/zero-1024-hackathon-*.key
/zero-1024-hackathon-*.pptx
/zero-1024-hackathon-*.pdf

# 效果图生成器的中间文件（SVG 内嵌了大量 base64，只提交导出的 PNG）
docs/v6/mockups/v6-*.svg
