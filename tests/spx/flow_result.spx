// 流程：胜利、金币、翻倍、下一关、重打、全部通关（F11~F15、F18），见 docs/v4/TEST_PLAN.md 第 3.4 节
// timeout: 90
onStart => {
	wait 3

	win := func(points int) {
		tCalm
		score = points
		killed = totalEnemy - 1
		enemiesAlive = 1
		enemyKilled 100
	}

	// F11 第 1 关胜利；F18 金币 = 得分 / 50 + 100
	playStage 1
	wait 0.5
	win 1000
	tInt "F11 消灭 20 辆 → 结算", state, stResult
	tCheck "F11 胜利", won
	tInt "F18 胜利金币 = 1100 / 50 + 100", coins, 1100/50+100
	tStr "F21 胜利结算画面", screen, "result_win_plain"

	// F12 看视频翻倍，只能翻一次
	confirm
	tInt "F12 结算 → 播放广告", state, stAd
	tInt "F12 奖励是翻倍", adReward, rewardDouble
	tCheck "F12 广告播完 → 结算", tWaitState(stResult, 7)
	tCheck "F12 已翻倍", doubled
	tInt "F12 金币翻倍", coins, (1100/50+100)*2
	tStr "F21 翻倍后的结算画面", screen, "result_win_done"
	confirm
	tInt "F12 不能再翻倍", state, stResult

	// F13 胜利 → 下一关，得分保留
	again
	wait 0.5
	tInt "F13 进入第 2 关", stage, 2
	tInt "F13 对局中", state, stPlay
	tInt "F13 进关得分", stageScore, 1100
	tInt "F13 得分保留", score, 1100

	// F14 战败 → 重打本关，得分回到进关时
	tCalm
	score = 1500
	revived = true
	baseDestroyed
	tInt "F14 战败结算", state, stResult
	tInt "F18 失败金币 = 1500 / 50", coins, 1500/50
	again
	wait 0.5
	tInt "F14 重打第 2 关", stage, 2
	tInt "F14 得分回到进关时", score, 1100

	// F15 第 8 关胜利 → 全部通关 → 从第 1 关重新开始
	playStage lastStage
	wait 0.5
	win 0
	tStr "F15 全部通关画面", screen, "result_final_plain"
	again
	wait 0.5
	tInt "F15 回到第 1 关", stage, 1
	tInt "F15 得分清零", score, 0

	// F16 结算 → 主页（H）
	tCalm
	revived = true
	baseDestroyed
	goHome
	wait 0.3
	tInt "F16 结算 → 主页", state, stHome

	tDone "flow_result"
}
