// 流程：主页出发的边（F01~F04）和回到主页（F16），见 docs/v4/TEST_PLAN.md 第 3.4 节
onStart => {
	wait 3

	tInt "F01 开始时在主页", state, stHome
	confirm // Enter / J
	wait 0.5
	tInt "F01 主页 Enter → 对局", state, stPlay
	tInt "F01 从第 1 关开始", stage, 1
	tCheck "F01 单人", !coop
	tStr "F21 对局中没有弹窗画面", screen, ""

	goHome
	wait 0.3
	tInt "F16 回到主页", state, stHome
	tStr "F16 主页画面", screen, "home"
	tCheck "F16 战场冻结", gameOver

	score = 999
	playStage 5
	wait 0.5
	tInt "F02 选关 → 对局", state, stPlay
	tInt "F02 第 5 关", stage, 5
	tInt "F02 进关得分从 0 开始", stageScore, 0
	tInt "F02 得分从 0 开始", score, 0

	goHome
	wait 0.3
	newGame 1, true
	wait 0.5
	tInt "F03 双人合作 → 对局", state, stPlay
	tCheck "F03 双人", coop
	tCheck "F03 2P 出现了", p2Exists

	goHome
	wait 0.3
	tCheck "F16 回主页时去掉 2P", !p2Exists

	openEditor
	wait 0.5
	tInt "F04 主页 → 编辑器", state, stEdit
	tStr "F04 编辑器画面", screen, "editor"
	tInt "F04 自制地图的关卡编号", stage, customStage

	goHome
	wait 0.3
	tInt "F16 编辑器 Esc → 主页", state, stHome

	// F34 主页的入口：开始战役、双人合作、自己做地图、选择关卡（v5 去掉了“每日挑战 · 即将推出”，原来的位置换成选择关卡）
	tCheck "F34 开始战役按钮", UI.hit("home.start", -140, 70)
	tCheck "F34 双人合作按钮", UI.hit("home.coop", -140, 17)
	tCheck "F34 自己做地图按钮", UI.hit("home.maker", -140, -27)
	for _, b := range []string{"home.start", "home.coop", "home.maker"} {
		tCheck "F34 原来每日挑战卡的位置没有按钮："+b, !UI.hit(b, -140, -71)
	}
	tCheck "F34 没有每日挑战按钮", !UI.hit("home.daily", -140, -71)
	tCheck "F34 选择关卡按钮", UI.hit("home.levels", -140, -71)

	// F35 选择关卡画面（v5 REVIEW A3）：鼠标、触屏也能选关，键盘 1~8 照样能用
	openLevels
	wait 0.3
	tInt "F35 主页 → 选关画面", state, stLevels
	tStr "F35 选关画面", screen, "levels"
	for n := 1; n <= lastStage; n++ {
		x := float64(16+(n-1)%4*112+52) - 240 // 卡片中心（build.py 的 levels：4 x 2，卡片 104 x 84，间距 8）
		y := 180 - float64(80+(n-1)/4*92+42)
		tCheck "F35 第 "+strconv.Itoa(n)+" 关的卡片", UI.hit("lv."+strconv.Itoa(n), x, y)
	}
	tCheck "F35 返回按钮", UI.hit("lv.back", -169, -109)
	escKey
	tInt "F35 选关画面 Esc → 主页", state, stHome
	tStr "F35 回到主页画面", screen, "home"
	openLevels
	wait 0.3
	newGame 6, false // 点第 6 关的卡片（或按 6）
	wait 0.5
	tInt "F35 选关 → 对局", state, stPlay
	tInt "F35 第 6 关", stage, 6
	tCheck "F35 单人", !coop
	goHome
	wait 0.3

	tDone "flow_home"
}
