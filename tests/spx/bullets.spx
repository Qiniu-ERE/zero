// 子弹和地形（C01~C07）：砖墙、钢墙、水面、草丛、基地、弹头两个检测点、2P 子弹、打中了哪辆坦克
// 见 docs/v4/TEST_PLAN.md 第 3.3 节；tQuiet / tAt 在 tools/test/prelude.spx
onStart => {
	wait 3

	tQuiet
	gameOver = true // 只调用函数，不需要战场在动
	i := tAt(5, 5)
	grid[i] = 1
	breakBrick i
	tInt "C01 砖墙打一下变成裂砖", grid[i], 3
	breakBrick i
	tInt "C01 裂砖再打一下消失", grid[i], 0

	grid[i] = 2
	tCheck "C02 钢墙挡住子弹", hitPoint(cellX(5), cellY(5), false)
	tInt "C02 钢墙打不碎", grid[i], 2

	for _, v := range []int{0, 4, 5} {
		grid[i] = v
		tCheck "C03 格子 "+strconv.Itoa(v)+" 子弹能飞过", !hitPoint(cellX(5), cellY(5), false)
	}
	grid[i] = 1
	tCheck "C03 砖墙挡住子弹", hitPoint(cellX(5), cellY(5), false)
	tInt "C03 子弹打砖墙会打裂", grid[i], 3
	tCheck "C03 战场外挡住子弹", hitPoint(cellX(0)-24, cellY(0), false)

	// C05 弹头左右两个检测点：从两块砖中间往上打，两块一起裂开
	grid[tAt(5, 5)] = 1
	grid[tAt(5, 6)] = 1
	tCheck "C05 打中了", bulletHit(cellX(5)+12, cellY(5)-3, 0, true)
	tInt "C05 左边的砖裂开", grid[tAt(5, 5)], 3
	tInt "C05 右边的砖裂开", grid[tAt(5, 6)], 3

	// C04 打中基地：失守；路演演示时不会失守
	grid[baseIdx] = 9
	autopilot = true
	gameOver = false
	tCheck "C04 演示模式：子弹被基地挡住", hitPoint(baseX, baseY, false)
	tCheck "C04 演示模式：基地没有失守", !baseDown
	autopilot = false
	hitPoint baseX, baseY, false
	tCheck "C04 基地失守", baseDown
	tInt "C04 进入复活询问", state, stRevive

	// C06 2P 的子弹朝向 + 1000
	for _, d := range []int{0, 90, 180, -90} {
		tInt "C06 1P 朝向 "+strconv.Itoa(d), bulletDir(d), d
		tInt "C06 2P 朝向 "+strconv.Itoa(d), bulletDir(d+1000), d
	}

	// C07 敌人子弹打中的是哪辆（Player 每帧都会更新 p1x / p2x，所以设置后马上检查，中间不等待）
	tQuiet
	keep := p2Exists
	p2Exists = false
	p1x, p1y, p2x, p2y = 0, 0, 10, 10
	tInt "C07 单人：永远是 1P", nearestPlayer(10, 10), 1
	p2Exists = true
	p1x, p1y, p2x, p2y = 0, 0, 100, 0
	tInt "C07 离 1P 近", nearestPlayer(20, 0), 1
	p1x, p1y, p2x, p2y = 0, 0, 100, 0
	tInt "C07 离 2P 近", nearestPlayer(80, 0), 2
	p2Exists = keep

	// C21~C24 自己的子弹也能打掉自己的老鹰（v5 PLAN 3.2）：真实发射子弹，看子弹飞过去的整个过程
	// （C04 只直接调用 hitPoint）。老鹰四周是砖墙，每块砖打两下才碎，所以第 3 发才打到老鹰

	// C21 1P 在出生点朝右（基地方向）开火
	playStage 1
	wait 0.5
	tCalm
	Player.setFace 90
	for n := 1; n <= 3; n++ {
		Player.shoot
		for i := 0; i < 30 && pbCount > 0; i++ {
			wait 0.1
		}
		if n == 1 {
			tInt "C21 第 1 发：护墙砖裂开", grid[tAt(12, 5)], 3
		} else if n == 2 {
			tInt "C21 第 2 发：护墙砖碎了", grid[tAt(12, 5)], 0
			tCheck "C21 第 2 发：老鹰还在", !baseDown
		}
	}
	tCheck "C21 第 3 发：老鹰被自己打掉", baseDown
	tInt "C21 进入复活询问", state, stRevive

	// C22 从基地正上方往下打
	playStage 1
	wait 0.5
	tCalm
	Player.setXYpos cellX(6), cellY(9)
	Player.setFace 180
	for n := 1; n <= 3; n++ {
		Player.shoot
		for i := 0; i < 30 && pbCount > 0; i++ {
			wait 0.1
		}
		if n == 2 {
			tInt "C22 第 2 发：上方的护墙砖碎了", grid[tAt(11, 6)], 0
			tCheck "C22 第 2 发：老鹰还在", !baseDown
		}
	}
	tCheck "C22 第 3 发：从上方打掉老鹰", baseDown
	tInt "C22 进入复活询问", state, stRevive

	// C23 双人时 2P 在出生点朝左打自己的基地（2P 开火就是 PBullet.fire 自己的位置和朝向，见 Player.shoot）
	newGame 1, true
	wait 0.5
	tCalm
	for n := 1; n <= 3; n++ {
		PBullet.fire cellX(8), cellY(12), -90, 2
		for i := 0; i < 30 && pbCount2 > 0; i++ {
			wait 0.1
		}
		if n == 2 {
			tInt "C23 第 2 发：右边的护墙砖碎了", grid[tAt(12, 7)], 0
		}
	}
	tCheck "C23 第 3 发：2P 打掉了老鹰", baseDown
	tInt "C23 进入复活询问", state, stRevive

	// C24 路演演示模式（自动驾驶）：子弹打到老鹰也打不掉
	newGame 1, false
	wait 0.5
	tCalm
	autopilot = true
	Player.dead = true // 让自动驾驶的坦克停下来，不要自己乱开火
	Player.shield = 99
	Player.hide
	for n := 1; n <= 4; n++ {
		PBullet.fire cellX(4), cellY(12), 90, 1
		for i := 0; i < 30 && pbCount > 0; i++ {
			wait 0.1
		}
	}
	tInt "C24 护墙砖照样打碎", grid[tAt(12, 5)], 0
	tCheck "C24 演示模式：老鹰打不掉", !baseDown && grid[baseIdx] == 9
	tInt "C24 演示模式：还在对局", state, stPlay
	autopilot = false

	goHome
	wait 0.3
	tDone "bullets"
}
