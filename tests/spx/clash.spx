// 子弹相撞、正对一块砖（C17、C18），见 docs/v4/TEST_PLAN.md 第 3.3 节
// timeout: 90
onStart => {
	wait 3

	// C17 子弹迎面相撞，互相抵消（README 的玩法规则）。
	// 横着、竖着各 5 次，每次把出发点挪一点（相遇的时机不同）；没有抵消的话，玩家子弹要 0.9 秒以上才飞出战场。
	// 原来用引擎的 touching 判断，子弹的碰撞区域几乎只是一个点，10 次只有 1~2 次能抵消（v4.0 的已知问题）；
	// v4.0.1 改成按距离判断（main.spx 的 bulletClash）
	cancelled := 0
	for k := 0; k < 10; k++ {
		tQuiet
		off := float64(k%5) * 2.4
		if k < 5 {
			PBullet.fire cellX(2)+off, cellY(6), 90, 1
			EBullet.fire cellX(10), cellY(6), -90
		} else {
			PBullet.fire cellX(6), cellY(10)-off, 0, 1
			EBullet.fire cellX(6), cellY(2), 180
		}
		t := 0.0
		for t < 1.2 && pbCount > 0 {
			waitNextFrame
			t += deltaTime
		}
		if t < 0.7 {
			cancelled++
		}
		wait 0.6
	}
	tInt "C17 迎面相撞 10 次都抵消", cancelled, 10
	tInt "C17 敌人子弹也消失了", len(ebPos), 0

	// C17 两颗子弹不完全在一条线上：坦克按半格（12 像素）对齐，子弹可能错开几个像素。
	// 错开 3 像素（画面上重叠）要抵消；错开 12 像素（画面上完全分开）不能抵消
	for _, c := range [][]float64{{3, 1}, {12, 0}} {
		tQuiet
		PBullet.fire cellX(2), cellY(6), 90, 1
		EBullet.fire cellX(10), cellY(6)+c[0], -90
		wait 0.6
		got := 0.0
		if pbCount == 0 {
			got = 1
		}
		what := map[bool]string{true: "抵消", false: "不抵消"}[c[1] == 1]
		tNum "C17 错开 "+strconv.Itoa(int(c[0]))+" 像素："+what, got, c[1]
		wait 1
	}

	// C17 相邻两行的子弹擦肩而过（相距 1 格 24 像素），不能抵消
	tQuiet
	PBullet.fire cellX(2), cellY(6), 90, 1
	EBullet.fire cellX(10), cellY(7), -90
	wait 0.6
	tInt "C17 相邻两行擦肩而过：玩家子弹还在", pbCount, 1
	tInt "C17 相邻两行擦肩而过：敌人子弹还在", len(ebPos), 1
	wait 1

	// 对照：没有敌人子弹时，0.6 秒时玩家子弹还在飞（说明上面“0.7 秒内消失”确实是被抵消的）
	tQuiet
	PBullet.fire cellX(2), cellY(6), 90, 1
	wait 0.6
	tInt "C17 对照：没有相撞时子弹还在", pbCount, 1
	wait 1

	// C18 正对一块砖（两个检测点在同一格）只打裂，不会一发打碎（v3.0.2 修复）
	tQuiet
	gameOver = true
	i := tAt(5, 5)
	grid[i] = 1
	tCheck "C18 打中了", bulletHit(cellX(5), cellY(5)-12, 0, true)
	tInt "C18 正对一块砖：裂开", grid[i], 3
	bulletHit cellX(5), cellY(5)-12, 0, true
	tInt "C18 第二发：碎掉", grid[i], 0

	goHome
	wait 0.3
	tDone "clash"
}
