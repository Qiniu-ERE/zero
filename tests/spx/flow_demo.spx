// 流程：路演演示模式（F22），见 docs/v4/TEST_PLAN.md 第 3.4 节
// 演示脚本：对局（自动驾驶）→ 切画风 → 切语言 → 防线失守 → 看视频复活 → 胜利 → 看视频翻倍
// → v6（三选一、车库、每日挑战、分享战报、排行榜、助战码）→ v5 选关 → v3（关卡、双人、编辑器）→ 回主页
// timeout: 270
onStart => {
	wait 3

	// 先在编辑器里留一张玩家自己的地图：演示会用编辑器，结束后要还原（v3.0.2）
	openEditor
	wait 0.5
	edRandom()
	edRebuild()
	mine := string(ed)
	loaded := edLoaded
	goHome
	wait 0.3

	t0, l0 := theme, lang
	w0, xp0, dd0, sp0 := wallet, cmdXP, dailyDay, seasonPts
	ds0, dsec0, db0, st0, ag0 := dailyScore, dailyBestSecs, strconv.Itoa(len(dailyBuild))+assistCode(dailyBuild), streak, assistGift
	broadcast "demoFlow" // 主页按 P
	wait 0.5
	tCheck "F22 演示开始：自动驾驶", autopilot
	tInt "F22 演示开始：对局中", state, stPlay

	seen := map[int]bool{}
	themeChanged, langChanged := false, false
	maxLv, sawDaily := 0, false
	finished := false
	for t := 0.0; t < 200; t += 0.25 {
		seen[state] = true
		if state == stPlay && lvl[1] > maxLv {
			maxLv = lvl[1]
		}
		if state == stPlay && stage == dailyStage {
			sawDaily = true
		}
		if theme != t0 {
			themeChanged = true
		}
		if lang != l0 {
			langChanged = true
		}
		if state == stHome && !demoOn { // v6 起演示中途会回主页（车库、每日挑战），要看演示是否结束
			finished = true
			break
		}
		wait 0.25
	}
	tCheck "F22 演示中切换过画风", themeChanged
	tCheck "F22 演示中切换过语言", langChanged
	tCheck "F22 演示经过了复活询问", seen[stRevive]
	tCheck "F22 演示经过了播放广告", seen[stAd]
	tCheck "F22 演示经过了结算", seen[stResult]
	tCheck "F22 演示结束回到主页", finished
	tCheck "F22 结束后关闭自动驾驶", !autopilot
	tInt "F22 画风恢复", theme, t0
	tInt "F22 语言恢复", lang, l0

	tStr "F22 演示结束后还原玩家的地图", string(ed), mine
	tCheck "F22 演示不改 edLoaded", edLoaded == loaded
	tCheck "F22 演示经过了编辑器", seen[stEdit]
	tCheck "F22 演示经过了暂停菜单", seen[stPause]
	tCheck "F22 v6：演示经过了三选一", seen[stPick]
	tCheck "F22 v6：演示里坦克升到了 Lv2 以上", maxLv >= 2
	tCheck "F22 v6：演示经过了车库", seen[stGarage]
	tCheck "F22 v6：演示经过了每日挑战", sawDaily
	tInt "F22 v6：演示不改钱包", wallet, w0
	tInt "F22 v6：演示不加指挥官经验", cmdXP, xp0
	tInt "F22 v6：演示不占今天的每日挑战正式成绩", dailyDay, dd0
	tInt "F22 v6：演示不加赛季积分", seasonPts, sp0
	tCheck "F22 v6：演示经过了分享战报", seen[stShare]
	tCheck "F22 v6：演示经过了排行榜", seen[stRanks]
	tCheck "F22 v6：演示经过了助战码", seen[stAssist]
	tCheck "F22 v5：演示经过了选关画面", seen[stLevels]
	tInt "F22 v6：演示还原今天正式成绩的得分", dailyScore, ds0
	tInt "F22 v6：演示还原今天正式成绩的用时", dailyBestSecs, dsec0
	tStr "F22 v6：演示还原今天正式成绩的芯片", strconv.Itoa(len(dailyBuild))+assistCode(dailyBuild), db0
	tInt "F22 v6：演示还原连续天数", streak, st0
	tInt "F22 v6：演示不留下助战芯片", assistGift, ag0

	// F36 演示中按 Esc 退出：马上回主页，演示脚本不再继续，画风、语言、编辑器地图都还原（v5 REVIEW A8）
	openEditor
	wait 0.5
	edRandom()
	edRebuild()
	mine2 := string(ed)
	goHome
	wait 0.3
	t1, l1 := theme, lang
	broadcast "demoFlow"
	wait 10 // 已经切过一次画风
	tCheck "F36 演示中：自动驾驶", autopilot
	escKey
	wait 0.5
	tInt "F36 按 Esc：回到主页", state, stHome
	tCheck "F36 按 Esc：关闭自动驾驶", !autopilot
	tInt "F36 按 Esc：画风还原", theme, t1
	tInt "F36 按 Esc：语言还原", lang, l1
	wait 8
	tInt "F36 演示脚本没有继续：还在主页", state, stHome
	tCheck "F36 演示脚本没有继续：没有自动驾驶", !autopilot
	tStr "F36 编辑器地图没被改", string(ed), mine2

	tDone "flow_demo"
}
